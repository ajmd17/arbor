(
    name: "Hazel",
    seed: 1,
    max_levels: 4,
    max_split_depth: 2,
    // A hazel is not a tree that has lost its trunk but a clump of a dozen of them:
    // straight, smooth, pale-brown rods coming up together from one stool, leaning out
    // into a vase and arching over at their ends under the weight of their foliage.
    // Everything that shapes it is in `basal` and in how the rods bend; the branching
    // off them is short, flat and fine, carrying broad leaves in two ranks.
    basal: (
        count: 11,
        count_variance: 3,
        lean_deg: 30.0,
        lean_variance_deg: 7.0,
        spread: 0.35,
        vigor_variance: 0.3,
    ),
    trunk: (
        length: 4.6,
        length_variance: 0.22,
        radius: 0.045,
        radius_ratio: 0.6,
        taper: 0.25,
        da_vinci_exponent: 2.2,
        segment_length: 0.28,
        curvature: 0.02,
        phototropism: 0.02,
        gravity: 0.008,
        // The rods stand straight from the ground and arch only toward their ends.
        droop: 2.5,
        zigzag_deg: 2.0,
        turn_bank: 0.3,
        vigor_falloff: 0.3,
        split_probability: 0.03,
        split_angle_deg: 22.0,
        split_evenness: 0.3,
        split_start_fraction: 0.45,
        children: (
            pattern: Continuous(density: 2.4),
            start_fraction: 0.3,
            end_fraction: 0.97,
            crotch_angle_deg: 48.0,
            crotch_angle_tip_deg: 36.0,
            crotch_variance_deg: 12.0,
            roll_variance_deg: 20.0,
            phyllotaxis_deg: 137.5,
            scale: 0.55,
            scale_variance: 0.3,
            dominance: 0.4,
            acrotony: 0.35,
        ),
    ),
    branch_levels: [
