        atlas_cols: 2,
        atlas_rows: 1,
        atlas_front: 1,
        atlas_back: 0,
        texture: "leaf_hazel",
    ),
    wind: (
        flutter: 0.7,
        // Thin rods on no trunk: the whole clump sways, and quickly.
        flexibility: (0.06, 0.35, 0.6, 1.0),
        frequency: 0.8,
    ),
    mesh: (
        // Smooth, glossy young bark: the birch set pulled from white to hazel's
