            swell_period: 1.5,
            burl_density: 0.0,
            knot_density: 0.0,
            collar_depth: 0.3,
            min_radius: 0.02,
            rings_per_meter: 10.0,
            ring_tolerance: 0.004,
        ),
    ),
    envelope: (
        volumes: [
            // A vase a little wider than it is tall, reaching into the ground so the
            // rods are inside it where they come up.
            Ellipsoid(center: (0.0, 2.4, 0.0), radii: (2.7, 2.9, 2.7)),
