(
    name: "Hanging vine",
    seed: 1,
    max_levels: 3,
    max_split_depth: 0,
    // A trailer spilling over the top of a wall: planted at the top edge, it runs a
    // pair of runners along under the coping, and from those hangs a curtain of
    // strands down the face, clinging loosely and swinging free in the wind. The
    // strands are the level below the runners, so each sways about the point on the
    // ledge it hangs from, as a limb does about its trunk.
    vine: Some((
        support: Wall(width: 5.0, height: 2.5, thickness: 0.3),
        start: Top,
        runners: 2,
        heading_deg: 90.0,
        fan_deg: 6.0,
        adhesion: 0.35,
        reach: 0.15,
        twine: 0.0,
        stand_off: 0.0,
        stand_off_deg: 0.0,
        crowding: 0.35,
        crowding_cell: 0.07,
        free_length: 0.0,
        leaf_lift_deg: 30.0,
    )),
    // The runners, along the top of the face.
    trunk: (
        length: 2.6,
        length_variance: 0.1,
        radius: 0.01,
        radius_ratio: 0.6,
        taper: 0.4,
        da_vinci_exponent: 2.2,
        segment_length: 0.06,
        curvature: 0.04,
        phototropism: 0.0,
        gravity: 0.0,
        vigor_falloff: 0.1,
        split_probability: 0.0,
        children: (
            pattern: Continuous(density: 5.0),
            start_fraction: 0.02,
            end_fraction: 0.97,
            crotch_angle_deg: 80.0,
            crotch_variance_deg: 15.0,
            scale: 0.7,
            scale_variance: 0.3,
        ),
    ),
    branch_levels: [
        (
            // The hanging strands.
            length: 2.0,
            length_variance: 0.3,
            radius: 0.005,
            radius_ratio: 0.6,
            taper: 0.4,
            da_vinci_exponent: 2.0,
            segment_length: 0.05,
            curvature: 0.12,
            phototropism: 0.0,
            gravity: 0.25,
            vigor_falloff: 0.2,
            split_probability: 0.0,
            children: (
                pattern: Continuous(density: 2.0),
                start_fraction: 0.1,
                end_fraction: 0.9,
                crotch_angle_deg: 35.0,
                crotch_variance_deg: 15.0,
                scale: 0.45,
                scale_variance: 0.3,
            ),
        ),
        (
            length: 0.4,
            length_variance: 0.3,
            radius: 0.0025,
            radius_ratio: 0.55,
            taper: 0.4,
            da_vinci_exponent: 2.0,
            segment_length: 0.04,
            curvature: 0.1,
            phototropism: 0.0,
            gravity: 0.15,
            vigor_falloff: 0.5,
            split_probability: 0.0,
            children: (
                pattern: None,
                start_fraction: 1.0,
                end_fraction: 0.0,
            ),
        ),
    ],
    gravity_multiplier: 1.0,
    phototropism_multiplier: 1.0,
    envelope_scale: 1.0,
    leaves: (
        enabled: true,
        min_level: 0,
        max_twig_radius: 0.03,
        density: 16.0,
        spacing_variance: 0.5,
        leafy_length: 0.0,
        cluster_size: 1,
        card_length: 0.08,
        card_width: 0.08,
        size_variance: 0.3,
        crotch_angle_deg: 60.0,
        crotch_variance_deg: 20.0,
        phyllotaxis_deg: 180.0,
