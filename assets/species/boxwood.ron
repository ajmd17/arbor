            curvature: 0.06,
            phototropism: 0.02,
            zigzag_deg: 8.0,
            turn_bank: 3.0,
            vigor_falloff: 0.6,
            split_probability: 0.0,
            children: (
                pattern: None,
                start_fraction: 1.0,
                end_fraction: 0.0,
            ),
        ),
    ],
    gravity_multiplier: 1.0,
    phototropism_multiplier: 1.0,
    envelope_scale: 1.0,
    leaves: (
        enabled: true,
        min_level: 1,
        max_twig_radius: 0.016,
        density: 16.0,
        spacing_variance: 0.8,
        leafy_length: 0.25,
        cluster_size: 2,
        cluster_spread_deg: 70.0,
        card_length: 0.2,
