            min_radius: 0.02,
            rings_per_meter: 12.0,
            ring_tolerance: 0.003,
        ),
    ),
    envelope: (
        volumes: [
            // Clipped: a hard-edged dome, pulled in hard wherever a shoot heads out.
            Ellipsoid(center: (0.0, 0.5, 0.0), radii: (0.8, 0.72, 0.8)),
        ],
        falloff: 0.12,
        kill_threshold: 0.05,
        pull_strength: 2.0,
    ),
)
