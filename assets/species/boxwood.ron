(
    name: "Boxwood",
    seed: 1,
    max_levels: 3,
    max_split_depth: 3,
    // Box: a low dome of small, glossy, evergreen leaves so dense that no wood shows.
    // A handful of stems come up from the root, fork evenly and often, and every tip
    // is held to the dome by a hard-edged envelope, which is what a clipped shrub is.
    basal: (
        count: 7,
        count_variance: 2,
        lean_deg: 32.0,
        lean_variance_deg: 8.0,
        spread: 0.12,
        vigor_variance: 0.2,
    ),
    trunk: (
        length: 1.1,
        length_variance: 0.15,
        radius: 0.022,
        radius_ratio: 0.6,
        taper: 0.3,
        da_vinci_exponent: 2.2,
        segment_length: 0.1,
        curvature: 0.05,
        phototropism: 0.03,
        gravity: 0.0,
        zigzag_deg: 6.0,
        turn_bank: 1.5,
        vigor_falloff: 0.25,
        split_probability: 0.2,
        split_angle_deg: 26.0,
        split_evenness: 0.7,
        split_start_fraction: 0.2,
        children: (
            pattern: Continuous(density: 12.0),
            start_fraction: 0.2,
            end_fraction: 0.97,
            crotch_angle_deg: 48.0,
            crotch_variance_deg: 14.0,
            roll_variance_deg: 30.0,
            phyllotaxis_deg: 137.5,
            scale: 0.6,
            scale_variance: 0.3,
            dominance: 0.3,
            acrotony: 0.4,
        ),
    ),
    branch_levels: [
