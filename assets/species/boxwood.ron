        phyllotaxis_deg: 137.5,
        droop_deg: 5.0,
        twist_deg: 60.0,
        even_roll: 1.0,
        // A clipped dome shades as one mass, so the normals lean hard to its outside.
        normal_blend: 0.75,
        curvature: 0.3,
        tint: (1.0, 1.0, 1.0),
        hue_variance: 0.1,
        interior_shade: 0.55,
        cluster: Some((
            // A sprig of box: a stiff shoot set with opposite pairs of small leaves.
            count: 16,
            shoots: 2,
            leaf_length: 0.16,
            base_angle_deg: 60.0,
            tip_angle_deg: 35.0,
            tip_scale: 0.75,
