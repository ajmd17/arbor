            radius_ratio: 0.6,
            taper: 0.3,
            da_vinci_exponent: 2.0,
            segment_length: 0.07,
            curvature: 0.06,
            phototropism: 0.03,
            gravity: 0.0,
            zigzag_deg: 8.0,
            turn_bank: 3.0,
            vigor_falloff: 0.4,
            split_probability: 0.0,
            children: (
                pattern: Continuous(density: 14.0),
                start_fraction: 0.15,
                end_fraction: 0.97,
                crotch_angle_deg: 42.0,
                crotch_variance_deg: 14.0,
                roll_variance_deg: 30.0,
                phyllotaxis_deg: 137.5,
                scale: 0.55,
