(
    name: "Forest oak",
    seed: 1,
    max_levels: 6,
    max_split_depth: 2,
    // An English oak grown up among others: a tall clean bole kept to the top, a narrow
    // crown of ascending, crooked limbs, and leaves in loose sprays rather than a dome.
    // Matched against Quixel's Megaplants English oak in a white studio; the open-grown
    // oak with the spreading crown is `oak`.
    trunk: (
        length: 20.0,
        length_variance: 0.12,
        radius: 0.2,
        radius_ratio: 0.58,
        taper: 0.30,
        da_vinci_exponent: 2.6,
        segment_length: 0.5,
        curvature: 0.003,
        phototropism: 0.010,
        gravity: 0.003,
        droop: 0.0,
        zigzag_deg: 0.0,
        vigor_falloff: 0.22,
        split_probability: 0.02,
        split_angle_deg: 20.0,
        // Near zero: the leader is kept to the top, as a forest oak keeps it, and the
        // rare fork stays a side branch.
        split_evenness: 0.15,
        split_start_fraction: 0.66,
        children: (
            pattern: Continuous(density: 1.4),
            start_fraction: 0.33,
            end_fraction: 0.98,
            crotch_angle_deg: 52.0,
            crotch_angle_tip_deg: 46.0,
            crotch_variance_deg: 11.0,
            roll_variance_deg: 18.0,
            phyllotaxis_deg: 137.5,
            scale: 0.50,
            scale_variance: 0.25,
            dominance: 0.55,
            acrotony: 0.40,
        ),
    ),
    branch_levels: [
        (
            // The limbs: ascending, and crooked where a birch's arch, which is the
            // zigzag on every level below. Half a birch's droop and gravity throughout.
            length: 4.6,
            length_variance: 0.24,
            radius: 0.055,
            radius_ratio: 0.62,
            taper: 0.30,
            da_vinci_exponent: 2.8,
            segment_length: 0.35,
            curvature: 0.05,
            phototropism: 0.030,
            gravity: 0.006,
            droop: 1.04,
            zigzag_deg: 5.0,
            turn_bank: 0.13,
            vigor_falloff: 0.34,
            dieback: 0.04,
            snap_radius: 0.04,
            split_probability: 0.18,
            split_angle_deg: 24.0,
            split_evenness: 0.35,
            split_start_fraction: 0.32,
            children: (
                // Raised when `tip_reach` began holding every branch to the one ahead of it:
                // shorter branches carry fewer twigs, so it takes more to the metre to keep the
                // crown as full.
                pattern: Continuous(density: 3.4),
                start_fraction: 0.18,
                end_fraction: 0.97,
                crotch_angle_deg: 44.0,
                crotch_variance_deg: 11.0,
                roll_variance_deg: 13.0,
                phyllotaxis_deg: 137.5,
                scale: 0.58,
                scale_variance: 0.28,
                dominance: 0.6,
                acrotony: 0.45,
                planarity: 0.55,
            ),
        ),
        (
            length: 2.6,
            length_variance: 0.32,
            radius: 0.034,
            radius_ratio: 0.56,
            taper: 0.28,
            da_vinci_exponent: 2.6,
            segment_length: 0.24,
            curvature: 0.055,
            phototropism: 0.010,
            gravity: 0.030,
            droop: 0.80,
            zigzag_deg: 10.0,
            turn_bank: 1.0,
            vigor_falloff: 0.42,
            dieback: 0.06,
            snap_radius: 0.035,
            split_probability: 0.12,
            split_angle_deg: 20.0,
            split_evenness: 0.2,
            split_start_fraction: 0.35,
            children: (
                pattern: Continuous(density: 5.2),
                start_fraction: 0.2,
                end_fraction: 0.98,
                crotch_angle_deg: 34.0,
                crotch_variance_deg: 10.0,
                roll_variance_deg: 14.0,
                phyllotaxis_deg: 137.5,
                scale: 0.55,
                scale_variance: 0.22,
                dominance: 0.35,
                acrotony: 0.7,
                planarity: 0.62,
            ),
        ),
        (
            length: 1.70,
            length_variance: 0.24,
            radius: 0.015,
            radius_ratio: 0.5,
            taper: 0.26,
            da_vinci_exponent: 2.5,
            segment_length: 0.18,
            curvature: 0.05,
            phototropism: 0.004,
            gravity: 0.060,
            droop: 0.60,
            zigzag_deg: 8.8,
            turn_bank: 3.0,
            vigor_falloff: 0.5,
            dieback: 0.09,
            snap_radius: 0.03,
            split_probability: 0.0,
            split_angle_deg: 16.0,
            split_evenness: 0.0,
            split_start_fraction: 0.4,
            children: (
                pattern: Continuous(density: 4.8),
                start_fraction: 0.2,
                end_fraction: 0.98,
                crotch_angle_deg: 30.0,
                crotch_variance_deg: 10.0,
                roll_variance_deg: 15.0,
                phyllotaxis_deg: 137.5,
                scale: 0.52,
                scale_variance: 0.20,
                dominance: 0.28,
                acrotony: 0.75,
                planarity: 0.62,
            ),
        ),
        (
            length: 0.82,
            length_variance: 0.26,
            radius: 0.0075,
            radius_ratio: 0.46,
            taper: 0.25,
            da_vinci_exponent: 2.4,
            segment_length: 0.15,
            curvature: 0.055,
            phototropism: 0.002,
            gravity: 0.080,
            droop: 0.40,
            zigzag_deg: 10.0,
            turn_bank: 3.0,
            vigor_falloff: 0.6,
            dieback: 0.11,
            snap_radius: 0.025,
            split_probability: 0.0,
            split_angle_deg: 14.0,
            split_evenness: 0.0,
            split_start_fraction: 0.4,
            children: (
                pattern: Continuous(density: 5.4),
                start_fraction: 0.15,
                end_fraction: 0.98,
                crotch_angle_deg: 28.0,
                crotch_variance_deg: 11.0,
                roll_variance_deg: 16.0,
                phyllotaxis_deg: 137.5,
                scale: 0.5,
                scale_variance: 0.18,
                dominance: 0.22,
                acrotony: 0.75,
                planarity: 0.58,
            ),
        ),
        (
            length: 0.38,
            length_variance: 0.30,
            radius: 0.004,
            radius_ratio: 0.44,
            taper: 0.3,
            da_vinci_exponent: 2.4,
            segment_length: 0.11,
            curvature: 0.06,
            phototropism: 0.0,
            gravity: 0.100,
            droop: 0.20,
            zigzag_deg: 12.5,
            turn_bank: 3.0,
            vigor_falloff: 0.7,
            dieback: 0.12,
            snap_radius: 0.02,
            split_probability: 0.0,
            split_angle_deg: 12.0,
            split_evenness: 0.0,
            split_start_fraction: 0.5,
            children: (
                pattern: None,
                start_fraction: 1.0,
                end_fraction: 0.0,
                crotch_angle_deg: 40.0,
                crotch_variance_deg: 20.0,
                roll_variance_deg: 40.0,
                phyllotaxis_deg: 137.5,
                scale: 0.5,
            ),
        ),
    ],
    gravity_multiplier: 1.0,
    phototropism_multiplier: 1.0,
    envelope_scale: 1.0,
    leaves: (
        enabled: true,
        min_level: 3,
        max_twig_radius: 0.03,
        // Small leaves in loose sprays on the last stretch of each shoot, and few
        // enough of them that the crown is mostly sky: the branchwork is the tree and
        // the foliage is a veil over the ends of it.
        // Lowered from 1.65 when leaves began to be laid back from the tip of a twig,
        // which puts the first of them at the very end of every shoot: the same
        // count of cards as before, so the crown is as full as it was tuned.
        density: 1.528,
        spacing_variance: 0.85,
        leafy_length: 0.6,
        cluster_size: 2,
        cluster_spread_deg: 70.0,
        card_length: 0.65,
        card_width: 0.65,
        size_variance: 0.35,
        crotch_angle_deg: 50.0,
        crotch_variance_deg: 26.0,
        phyllotaxis_deg: 137.5,
        droop_deg: 14.0,
        twist_deg: 60.0,
        even_roll: 1.0,
        normal_blend: 0.5,
        curvature: 0.3,
        tint: (1.954, 1.954, 2.112),
        saturation: 0.359,
        transmission: 0.32,
        hue_variance: 0.14,
        green_variance: 0.0,
        interior_shade: 0.05,
        cluster: Some((
            // A sprig: three thin shoots set with oval leaves eight or nine centimetres
            // long, spaced so each leaf keeps its own outline against the sky.
            count: 100,
            shoots: 3,
            leaf_length: 0.15,
            base_angle_deg: 70.0,
            tip_angle_deg: 40.0,
            tip_scale: 0.8,
            angle_variance_deg: 20.0,
            roll_deg: 137.5,
            roll_variance_deg: 30.0,
            depth: 0.7,
            blade_twist_deg: 50.0,
            depth_shade: 0.4,
            size_variance: 0.3,
            spacing_variance: 0.5,
            shoot_curve: 0.2,
            variants: 4,
            shoot_base: 0.96,
            shoot_tip: 0.14,
            source_aspect: 0.667,
            sources: 8,
            cell_size: 1024,
        )),
        // The bake's source: eight English oak leaves stacked down the sheet, off Raw
        // Catalog's Atlas-1093-A, with the map of the light each lets through. This
        // tree wore the open oak's elm leaves at first; the oak's own lobed leaf bakes
        // into an airier spray, so the card carries a hundred of them where it carried
        // sixty-four elm. The sheet was scanned from above only, so the underside in
        // the right-hand column is the same leaf made paler and greyer. To rebuild it:
        //
        //   import_textures oak_scan_sheet --size 4096
        //       --rawcatalog D:/RawCatalog/2966_green-oak-leaves
        //   repack_atlas oak_scan_sheet leaf_oak_scan --keep 14 --pick 2,3,4,5,6,7,8,9
        //       --cell 384x576 --back 0.6,1.2
        //
        // after which the sheet can be deleted. The two leaves left out lie sideways.
        atlas_cols: 2,
        atlas_rows: 1,
        atlas_front: 0,
        atlas_back: 1,
        texture: "leaf_oak_scan",
    ),
    wind: (
        flutter: 0.5,
        flexibility: (0.05, 0.15, 0.35, 0.8),
        frequency: 0.35,
    ),
    mesh: (
        // The open oak's bark, culled coarser. Its twigs were meshed down to a few
        // millimetres for a tree looked at for its wood, which here came to 32k
        // triangles; at a centimetre this crown is 5k and the studio score does not
        // move, since its sprays sit at the ends of limbs thick enough to keep.
        uv_scale: 0.8,
        silhouette_tolerance: 0.02,
        min_radial: 4,
        min_bark_radius: 0.010,
        max_radial: 24,
        root_flare: 0.6,
        flare_height: 1.1,
        root_taper: 2.2,
        root_depth: 0.16,
        root_split: 3.5,
        root_grooves: 0.12,
        root_sharpness: 0.7,
        root_count: 5,
        tip_length: 0.04,
        socket_flare: 0.85,
        socket_bias: 0.9,
        socket_power: 3.2,
        bark_texture: "bark_oak",
        moss_color: (0.19, 0.27, 0.12),
        moss_height: 1.6,
        moss_amount: 0.0,
        bark_darken_low: 0.25,
        bark_tint: (1.35, 1.4, 1.45),
        irregularity: (
            flute_depth: 0.06,
            flute_waves: 9.0,
            flute_twist: 0.07,
            swell_depth: 0.05,
            swell_period: 1.6,
            burl_density: 0.35,
            burl_depth: 0.2,
            burl_size: 0.4,
            // Scars of the limbs the tree shed on its way up, so they start a little
            // under the lowest branch it still carries and thin out from there. The
            // clean bole below that is most of what a person standing by the trunk
            // actually sees.
            knot_density: 0.3,
            knot_depth: 0.14,
            knot_size: 0.16,
            knot_reach: 1.5,
            knot_min_stem: 0.8,
            collar_depth: 0.85,
            bark_ridge: 0.35,
            min_radius: 0.04,
            rings_per_meter: 14.0,
            ring_tolerance: 0.02,
        ),
    ),
    envelope: (
        // The volumes below are metres around a trunk this long; declared longer or
        // shorter, they stretch along it so the crown keeps its place on the tree.
        for_trunk_length: 20.0,
        volumes: [
            // Tall and narrow, as the studio reference is, with lobes leaning the
            // crown a little off the axis so it is not a solid of revolution.
            Ellipsoid(center: (0.0, 13.0, 0.0), radii: (4.2, 7.6, 4.2)),
            Ellipsoid(center: (0.4, 18.4, -0.4), radii: (2.8, 3.4, 2.8)),
            Ellipsoid(center: (-0.8, 8.4, 0.6), radii: (3.8, 4.6, 3.8)),
            Ellipsoid(center: (1.0, 11.8, 1.2), radii: (3.4, 4.4, 3.4)),
        ],
        falloff: 0.30,
        kill_threshold: 0.025,
        pull_strength: 0.36,
    ),
)
