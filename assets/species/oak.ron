    gravity_multiplier: 1.0,
    phototropism_multiplier: 1.0,
    envelope_scale: 1.0,
    leaves: (
        enabled: true,
        min_level: 1,
        max_twig_radius: 0.06,
        // A tuft of cards at each anchor and the anchors scattered rather than
        // stepped, so the canopy comes out as masses with holes between them. An oak
        // wears its foliage on the last half metre of every shoot, which is what
        // leaves the limbs showing through those holes instead of burying them.
        density: 0.80,
        spacing_variance: 0.85,
        leafy_length: 0.32,
        // Two cards to a tuft, crossed by `even_roll` so neither is ever seen alone
        // edge on, each 0.8 m and carrying a baked cluster of 128 leaves on three
        // shoots. This was four 0.6 m cards of 72 leaves: the same leaves at the same
        // size in half the cards, which took the foliage from 19.3k triangles to 9.7k.
        // The three shoots are what keep a bigger cell a clump: on one shoot a cell of
        // small leaves can only fill a strip two leaves wide, and the crown came out
        // as long ribbons of leaves.
        cluster_size: 2,
        cluster_spread_deg: 70.0,
        card_length: 0.8,
        card_width: 0.8,
        size_variance: 0.4,
        crotch_angle_deg: 58.0,
        crotch_variance_deg: 26.0,
        phyllotaxis_deg: 137.5,
        droop_deg: 26.0,
        twist_deg: 60.0,
        even_roll: 1.0,
        normal_blend: 0.6,
        curvature: 0.35,
        tint: (0.55, 0.88, 0.42),
        hue_variance: 0.18,
        interior_shade: 0.55,
        cluster: Some((
            count: 128,
            shoots: 3,
            leaf_length: 0.19,
            base_angle_deg: 92.0,
            tip_angle_deg: 66.0,
            tip_scale: 0.8,
            angle_variance_deg: 20.0,
            roll_deg: 137.5,
            roll_variance_deg: 30.0,
            depth: 0.8,
            blade_twist_deg: 60.0,
            depth_shade: 0.45,
            size_variance: 0.32,
            spacing_variance: 0.5,
            shoot_curve: 0.15,
            variants: 4,
            shoot_base: 0.94,
            shoot_tip: 0.14,
            source_aspect: 0.808,
            cell_size: 1024,
        )),
        atlas_cols: 2,
        atlas_rows: 1,
        atlas_front: 1,
        atlas_back: 0,
        texture: "leaf_oak",
    ),
    wind: (
        strength: 0.35,
        gustiness: 0.4,
        flutter: 0.5,
        flexibility: (0.05, 0.15, 0.35, 0.8),
    ),
    mesh: (
        // Budgeted for a forest rather than for a hero shot. Bark is the part nobody
        // sees once the canopy is on, so it is bought cheaply: a three-centimetre
        // silhouette tolerance and nothing thinner than a wrist left meshed at all. The
        // wood under the leaves went from 67k triangles to 16k, for a tree
        // indistinguishable in leaf.
        //
        // The rings are the one thing not bought cheaply. Thinning them to three
        // centimetres as well took the bark to 7.8k, and it showed: the branch collars
        // go (a limb meets the trunk at a seam rather than growing out of a swelling),
        // and so does the slow swell along the bole. Two centimetres keeps both and
        // costs 19.1k; 0.025 is the halfway house at 12.4k and keeps about a fifth of
        // the collars, which is not enough to read.
        //
        // `max_radial` stays at 32 where the other presets take 16. Most stems never
        // reach it, but the bole does, and its five buttress roots need the sides to
        // show as roots: at 16 the flare at the foot collapses into a plain cone. It
        // costs a few hundred triangles on one stem. The mesher keeps the trunk's rings
        // fine inside its flare zone for the same reason, whatever the budget above.
        //
        // `min_radial` is 4 rather than 3 on purpose: at this tolerance every thin limb
        // otherwise collapses to a triangular prism, which reads as a flat ribbon as it
        // turns. The extra side costs about 700 triangles over the whole tree.
        uv_scale: 0.8,
        silhouette_tolerance: 0.03,
        min_radial: 4,
        min_bark_radius: 0.038,
        max_radial: 32,
        root_flare: 1.9,
        flare_height: 2.2,
        root_taper: 2.2,
        root_depth: 0.26,
        root_split: 3.5,
        root_grooves: 0.12,
        root_sharpness: 0.7,
        root_count: 5,
        tip_length: 0.06,
        socket_flare: 0.85,
        socket_bias: 0.9,
        socket_power: 3.2,
        bark_texture: "bark_oak",
        moss_color: (0.19, 0.27, 0.12),
        moss_height: 4.0,
        moss_amount: 0.6,
        bark_darken_low: 0.25,
        irregularity: (
            flute_depth: 0.085,
            flute_waves: 9.0,
            flute_twist: 0.07,
            swell_depth: 0.05,
            swell_period: 2.4,
            burl_density: 0.35,
            burl_depth: 0.2,
            burl_size: 0.4,
            // Scars of the limbs the tree shed on its way up, so they start a little
            // under the lowest branch it still carries and thin out from there. The
            // clean bole below that is most of what a person standing by the trunk
            // actually sees.
            knot_density: 0.3,
            knot_depth: 0.14,
            knot_size: 0.26,
            knot_reach: 3.0,
            knot_min_stem: 1.3,
            collar_depth: 0.85,
            bark_ridge: 0.35,
            min_radius: 0.06,
            rings_per_meter: 14.0,
            ring_tolerance: 0.02,
        ),
    ),
    envelope: (
        volumes: [
            // A mature oak crown is several masses that grew into each other, not one
            // dome. Overlapping lobes give the silhouette its lumps and let the gaps
            // between them show the limbs, which one ellipsoid never will.
            Ellipsoid(center: (0.0, 9.8, 0.0), radii: (10.1, 6.9, 10.1)),
            Ellipsoid(center: (-5.9, 8.4, 1.7), radii: (6.6, 4.9, 6.6)),
            Ellipsoid(center: (5.7, 9.0, -2.2), radii: (6.8, 5.1, 6.8)),
            Ellipsoid(center: (1.4, 7.9, 5.8), radii: (6.4, 4.7, 6.4)),
            Ellipsoid(center: (-1.2, 13.1, -1.4), radii: (7.1, 4.5, 7.1)),
            Ellipsoid(center: (-3.8, 11.7, 5.0), radii: (5.4, 3.7, 5.4)),
            Ellipsoid(center: (4.2, 12.3, 3.5), radii: (5.2, 3.5, 5.2)),
            Ellipsoid(center: (-2.4, 6.5, -5.4), radii: (5.4, 3.9, 5.4)),
        ],
        falloff: 0.28,
        kill_threshold: 0.02,
        pull_strength: 0.45,
    ),
)
