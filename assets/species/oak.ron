    gravity_multiplier: 1.0,
    phototropism_multiplier: 1.0,
    envelope_scale: 1.0,
    leaves: (
        enabled: true,
        min_level: 1,
        max_twig_radius: 0.03,
        // Small leaves in loose sprays on the last stretch of each shoot, and few
        // enough of them that the crown is mostly sky: the branchwork is the tree and
        // the foliage is a veil over the ends of it.
        // Lowered from 2.5 when leaves began to be laid back from the tip of a twig,
        // which puts the first of them at the very end of every shoot: the same
        // count of cards as before, so the crown is as full as it was tuned.
        density: 2.208,
        spacing_variance: 0.85,
        leafy_length: 0.6,
        cluster_size: 2,
        cluster_spread_deg: 70.0,
        card_length: 0.6,
        card_width: 0.6,
        size_variance: 0.35,
        crotch_angle_deg: 50.0,
        crotch_variance_deg: 26.0,
        phyllotaxis_deg: 137.5,
        droop_deg: 14.0,
        twist_deg: 60.0,
        even_roll: 1.0,
        normal_blend: 0.5,
        curvature: 0.3,
        tint: (0.6, 0.8, 0.5),
        hue_variance: 0.14,
        interior_shade: 0.4,
        cluster: Some((
            // A sprig: three thin shoots set with oval leaves eight or nine centimetres
            // long, spaced so each leaf keeps its own outline against the sky.
            count: 64,
            shoots: 3,
            leaf_length: 0.15,
            base_angle_deg: 70.0,
            tip_angle_deg: 40.0,
            tip_scale: 0.8,
            angle_variance_deg: 20.0,
            roll_deg: 137.5,
            roll_variance_deg: 30.0,
            depth: 0.7,
            blade_twist_deg: 50.0,
            depth_shade: 0.4,
            size_variance: 0.3,
            spacing_variance: 0.5,
            shoot_curve: 0.2,
            variants: 4,
            shoot_base: 0.96,
            shoot_tip: 0.14,
            source_aspect: 0.667,
            sources: 6,
            cell_size: 1024,
        )),
        // The bake's source: six elm leaves stacked down the sheet, off Raw Catalog's
        // Atlas-1029-A, with the map of the light each lets through. The sheet was
        // scanned from above only, so the underside in the right-hand column is the
        // same leaf made paler and greyer. To rebuild it:
        //
        //   import_textures elm_scan_sheet --size 4096
        //       --rawcatalog D:/RawCatalog/2902_green-elm-leaves
        //   repack_atlas elm_scan_sheet leaf_elm --keep 12 --pick 0,1,3,4,5,7
        //       --cell 384x576 --back 0.6,1.2
        //
        // after which the sheet can be deleted.
        atlas_cols: 2,
        atlas_rows: 1,
        atlas_front: 0,
        atlas_back: 1,
        texture: "leaf_elm",
    ),
    wind: (
        flutter: 0.5,
        flexibility: (0.05, 0.15, 0.35, 0.8),
        frequency: 0.35,
    ),
    mesh: (
        // The wood is what this tree is looked at for, so twigs stay meshed down to
        // little more than a centimetre: culled any coarser and the sprays hang in
        // the air off the ends of limbs that stop short of them.
        uv_scale: 0.8,
        silhouette_tolerance: 0.02,
        min_radial: 4,
        min_bark_radius: 0.004,
        max_radial: 24,
        root_flare: 1.5,
        flare_height: 1.1,
        root_taper: 2.2,
        root_depth: 0.16,
        root_split: 3.5,
        root_grooves: 0.12,
        root_sharpness: 0.7,
        root_count: 5,
        tip_length: 0.04,
        socket_flare: 0.85,
        socket_bias: 0.9,
        socket_power: 3.2,
        bark_texture: "bark_oak",
        moss_color: (0.19, 0.27, 0.12),
        moss_height: 1.6,
        moss_amount: 0.25,
        bark_darken_low: 0.25,
        irregularity: (
            flute_depth: 0.06,
            flute_waves: 9.0,
            flute_twist: 0.07,
            swell_depth: 0.05,
            swell_period: 1.6,
            burl_density: 0.35,
            burl_depth: 0.2,
            burl_size: 0.4,
            // Scars of the limbs the tree shed on its way up, so they start a little
            // under the lowest branch it still carries and thin out from there. The
            // clean bole below that is most of what a person standing by the trunk
            // actually sees.
            knot_density: 0.3,
            knot_depth: 0.14,
            knot_size: 0.16,
            knot_reach: 1.5,
            knot_min_stem: 0.8,
            collar_depth: 0.85,
            bark_ridge: 0.35,
            min_radius: 0.04,
            rings_per_meter: 14.0,
            ring_tolerance: 0.02,
        ),
    ),
    envelope: (
        // The volumes below are metres around a trunk this long; declared longer or
        // shorter, they stretch along it so the crown keeps its place on the tree.
        for_trunk_length: 12.0,
        volumes: [
            // A low, wide parasol: one flattened mass with lobes leaning out of it, its
            // underside well clear of the ground so the bole and the fork stand in
            // the open beneath.
            Ellipsoid(center: (0.0, 8.4, 0.0), radii: (8.2, 4.8, 8.2)),
            Ellipsoid(center: (-5.2, 7.2, 1.4), radii: (4.8, 3.2, 4.8)),
            Ellipsoid(center: (5.4, 7.8, -1.8), radii: (5.0, 3.3, 5.0)),
            Ellipsoid(center: (1.0, 7.0, 5.3), radii: (4.6, 3.1, 4.6)),
            Ellipsoid(center: (-1.2, 10.6, -1.2), radii: (5.0, 3.0, 5.0)),
            Ellipsoid(center: (-2.0, 6.9, -5.2), radii: (4.4, 3.0, 4.4)),
        ],
        falloff: 0.28,
        kill_threshold: 0.02,
        pull_strength: 0.45,
    ),
)
