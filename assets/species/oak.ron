        split_angle_deg: 46.0,
        // An open-grown oak of the dry-country kind: a clear bole to a little over
        // head height, where the leader gives out and three or four limbs come away
        // as equals, climbing steeply before they arch out into a crown wider than
        // it is tall. Every one of those limbs is a continuation of the trunk, which
        // is why they are slender and long rather than spokes off a mast.
        split_evenness: 0.9,
        split_start_fraction: 0.22,
        children: (
            pattern: Continuous(density: 0.8),
            start_fraction: 0.26,
            end_fraction: 0.96,
