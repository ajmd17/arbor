(
    name: "Birch",
    seed: 1,
    max_levels: 6,
    max_split_depth: 2,
    // A birch is a slender tree that keeps its leader most of the way up, hangs its
    // fine work, and lets the light through. Almost everything below is one of those
    // three: a thin bole with little taper, split_evenness near zero so a fork stays a
    // side branch, droop climbing level by level until the last shoots hang straight
    // down, and a crown envelope a third the width of the oak's for the same height.
    trunk: (
        length: 20.0,
        length_variance: 0.12,
        radius: 0.17,
        radius_ratio: 0.58,
        taper: 0.30,
        da_vinci_exponent: 2.2,
        segment_length: 0.5,
        curvature: 0.008,
        phototropism: 0.030,
        gravity: 0.003,
        droop: 0.0,
        zigzag_deg: 0.0,
        vigor_falloff: 0.22,
        split_probability: 0.10,
        split_angle_deg: 20.0,
        // Near zero: a birch that gave up its leader the way the oak does would come
        // out as a shrub. The rare fork stays a side branch and the bole carries on.
        split_evenness: 0.15,
        split_start_fraction: 0.66,
        children: (
            pattern: Continuous(density: 1.6),
            start_fraction: 0.30,
            end_fraction: 0.98,
            crotch_angle_deg: 66.0,
            crotch_angle_tip_deg: 46.0,
            crotch_variance_deg: 11.0,
            roll_variance_deg: 18.0,
            phyllotaxis_deg: 137.5,
            scale: 0.50,
            scale_variance: 0.25,
            dominance: 0.55,
            acrotony: 0.40,
        ),
    ),
    branch_levels: [
        (
            // The limbs. Long enough to have real turning to spend, which is what lets
            // them leave the trunk climbing and come over the top by their ends.
            length: 5.8,
            length_variance: 0.24,
            radius: 0.075,
            radius_ratio: 0.62,
            taper: 0.30,
            da_vinci_exponent: 2.2,
            segment_length: 0.35,
            curvature: 0.05,
            phototropism: 0.030,
            gravity: 0.012,
            droop: 2.6,
            zigzag_deg: 2.0,
            // Birch limbs arch; they do not come round on themselves. At the model's
            // own rate a limb this long banks enough turning to close a quarter circle,
            // and the crown pull spends every radian of it.
            turn_bank: 0.13,
            vigor_falloff: 0.34,
            dieback: 0.04,
            snap_radius: 0.04,
            split_probability: 0.18,
            split_angle_deg: 24.0,
            split_evenness: 0.35,
            split_start_fraction: 0.32,
            children: (
                // Raised when `tip_reach` began holding every branch to the one ahead of it:
                // shorter branches carry fewer twigs, so it takes more to the metre to keep the
                // crown as full.
                pattern: Continuous(density: 3.4),
                start_fraction: 0.18,
                end_fraction: 0.97,
                crotch_angle_deg: 44.0,
                crotch_variance_deg: 11.0,
                roll_variance_deg: 13.0,
                phyllotaxis_deg: 137.5,
                scale: 0.58,
                scale_variance: 0.28,
                dominance: 0.6,
                acrotony: 0.45,
                // The first branch off a limb sets the plane its whole spray lies in.
                // Without it the branchlets spiral round the limb and come out as a
                // tangle radiating every which way, which is the one thing a birch,
                // whose branchwork you can see straight through, cannot hide.
                planarity: 0.55,
            ),
        ),
        (
            length: 2.6,
            length_variance: 0.32,
            radius: 0.034,
            radius_ratio: 0.56,
            taper: 0.28,
            da_vinci_exponent: 2.1,
            segment_length: 0.24,
            curvature: 0.055,
            phototropism: 0.010,
            gravity: 0.06,
            droop: 2.0,
            zigzag_deg: 4.0,
            // These are the shoots long enough to arch over and hang, and the bank is
            // what let them: at the default they could turn 27 degrees in all. With the
            // sag moved toward the base (less `droop`, more `gravity`) they bend from
            // where they leave rather than only at the tip, which is how a birch shoot
            // hangs. The finest levels below take the same treatment.
            turn_bank: 1.0,
            vigor_falloff: 0.42,
            dieback: 0.06,
            snap_radius: 0.035,
            split_probability: 0.12,
            split_angle_deg: 20.0,
            split_evenness: 0.2,
            split_start_fraction: 0.35,
            children: (
                pattern: Continuous(density: 5.2),
                start_fraction: 0.2,
                end_fraction: 0.98,
                crotch_angle_deg: 34.0,
                crotch_variance_deg: 10.0,
                roll_variance_deg: 14.0,
                phyllotaxis_deg: 137.5,
                scale: 0.55,
                scale_variance: 0.22,
                dominance: 0.35,
                acrotony: 0.7,
                planarity: 0.62,
            ),
        ),
        (
            // Where the weeping starts. These are short enough that they cannot bend
            // far on their own, so most of the hang comes from leaving an already
            // arching parent at a wide angle rather than from curving afterwards.
            length: 1.70,
            length_variance: 0.24,
            radius: 0.015,
            radius_ratio: 0.5,
            taper: 0.26,
            da_vinci_exponent: 2.0,
            segment_length: 0.18,
            curvature: 0.05,
            phototropism: 0.004,
            gravity: 0.12,
            droop: 1.5,
            zigzag_deg: 3.5,
            // The turn bank is what kept these straight. It is drawn per metre of the stem's
            // length, and a twig under half a metre was allowed six degrees in all, so the
            // gravity and droop above it never got to act. A silver birch's fine twigs hang
            // like string; this is enough turning for them to do it.
            turn_bank: 3.0,
            vigor_falloff: 0.5,
            dieback: 0.09,
            snap_radius: 0.03,
            split_probability: 0.0,
            split_angle_deg: 16.0,
            split_evenness: 0.0,
            split_start_fraction: 0.4,
            children: (
                pattern: Continuous(density: 4.8),
                start_fraction: 0.2,
                end_fraction: 0.98,
                crotch_angle_deg: 30.0,
                crotch_variance_deg: 10.0,
                roll_variance_deg: 15.0,
                phyllotaxis_deg: 137.5,
                scale: 0.52,
                scale_variance: 0.20,
                dominance: 0.28,
                acrotony: 0.75,
                planarity: 0.62,
            ),
        ),
        (
            length: 0.82,
            length_variance: 0.26,
            radius: 0.0075,
            radius_ratio: 0.46,
            taper: 0.25,
            da_vinci_exponent: 2.0,
            segment_length: 0.15,
            curvature: 0.055,
            phototropism: 0.002,
            gravity: 0.16,
            droop: 1.0,
            zigzag_deg: 4.0,
            turn_bank: 3.0,
            vigor_falloff: 0.6,
            dieback: 0.11,
            snap_radius: 0.025,
            split_probability: 0.0,
            split_angle_deg: 14.0,
            split_evenness: 0.0,
            split_start_fraction: 0.4,
            children: (
                pattern: Continuous(density: 5.4),
                start_fraction: 0.15,
                end_fraction: 0.98,
                crotch_angle_deg: 28.0,
                crotch_variance_deg: 11.0,
                roll_variance_deg: 16.0,
                phyllotaxis_deg: 137.5,
                scale: 0.5,
                scale_variance: 0.18,
                dominance: 0.22,
                acrotony: 0.75,
                planarity: 0.58,
            ),
        ),
        (
            // The hanging shoots. They leave their parent pointing more down than out
            // and are too short to be bent back up by anything, which is the whole of
            // the weeping habit.
            length: 0.38,
            length_variance: 0.30,
            radius: 0.004,
            radius_ratio: 0.44,
            taper: 0.3,
            da_vinci_exponent: 2.0,
            segment_length: 0.11,
            curvature: 0.06,
            phototropism: 0.0,
            gravity: 0.2,
            droop: 0.5,
            zigzag_deg: 5.0,
            turn_bank: 3.0,
            vigor_falloff: 0.7,
            dieback: 0.12,
            snap_radius: 0.02,
            split_probability: 0.0,
            split_angle_deg: 12.0,
            split_evenness: 0.0,
            split_start_fraction: 0.5,
            children: (
                pattern: None,
                start_fraction: 1.0,
                end_fraction: 0.0,
                crotch_angle_deg: 40.0,
                crotch_variance_deg: 20.0,
                roll_variance_deg: 40.0,
                phyllotaxis_deg: 137.5,
                scale: 0.5,
            ),
        ),
    ],
    gravity_multiplier: 1.0,
    phototropism_multiplier: 1.0,
    envelope_scale: 1.0,
    leaves: (
        enabled: true,
        min_level: 2,
        max_twig_radius: 0.035,
        // A birch leaf is a third the length of an oak's, so the same art is baked
        // small and packed hard. The canopy is thinner than the oak's on purpose:
        // seeing the sky through a birch is most of what it looks like.
        // Two cards to a tuft, crossed by `even_roll`, each 0.42 m and carrying 88
        // leaves. This was three 0.3 m cards of 45 leaves at a density of 3: the same
        // leaves at the same size in a little over a third of the cards, which took the
        // foliage from 20.8k triangles to 10.4k with the canopy looking the same.
        density: 2.2,
        spacing_variance: 0.85,
        leafy_length: 0.30,
        cluster_size: 2,
        cluster_spread_deg: 62.0,
        card_length: 0.42,
        card_width: 0.42,
        size_variance: 0.4,
        crotch_angle_deg: 60.0,
        crotch_variance_deg: 28.0,
        phyllotaxis_deg: 137.5,
        droop_deg: 34.0,
        twist_deg: 60.0,
        even_roll: 1.0,
        normal_blend: 0.6,
        curvature: 0.35,
        tint: (0.78, 0.98, 0.52),
        hue_variance: 0.10,
        interior_shade: 0.34,
        cluster: Some((
            // Three shoots standing side by side rather than one. A birch leaf is a
            // third the length of the oak's, so a single shoot could only ever fill a
            // strip down the middle of the card, and the leaves piled into a solid
            // scalloped slab with the corners left empty either side of it.
            count: 88,
            shoots: 3,
            leaf_length: 0.118,
            base_angle_deg: 95.0,
            tip_angle_deg: 68.0,
            tip_scale: 0.85,
            angle_variance_deg: 26.0,
            roll_deg: 137.5,
            roll_variance_deg: 36.0,
            depth: 0.55,
            blade_twist_deg: 45.0,
            depth_shade: 0.30,
            size_variance: 0.40,
            spacing_variance: 0.70,
            shoot_curve: 0.22,
            variants: 4,
            shoot_base: 0.90,
            shoot_tip: 0.20,
            source_aspect: 0.808,
            cell_size: 1024,
        )),
        atlas_cols: 2,
        atlas_rows: 1,
        atlas_front: 1,
        atlas_back: 0,
        texture: "leaf_oak",
    ),
    wind: (
        flutter: 0.7,
        flexibility: (0.08, 0.25, 0.5, 0.9),
        // A small, whippy tree: quick.
        frequency: 0.55,
    ),
    mesh: (
        // Birch bark is smooth, so almost none of the relief the oak carries applies
        // here: no flutes to speak of, no burls, and a bole that is very nearly a
        // cylinder. What it does have is white wood seen against dark ground and sky,
        // which is most of what a birch looks like, and it is why this tree does not
        // take the three-centimetre budget the conifers do. It was tried: the bark
        // went from 7.4k triangles to under 800 and the tree went with it — the fine
        // white twigs between the leaves culled away, the limbs gone angular, the bole
        // faceted — and Andrew called it decimated. A centimetre and a half of
        // silhouette and the default ring spacing keep the trunk round and the limbs
        // smooth for 4.6k, which is what the budget buys here.
        //
        // `min_radial` stays at 4: the white limbs are the most visible wood on any
        // tree here, and at 3 they turn into flat ribbons.
        //
        // The twigs are the other half. They zigzag, so no ring along them can be
        // thinned away, and left meshed they were 62% of the whole tree's bark for wood
        // a centimetre across. Culling below the limbs at 1.3 cm of radius keeps the
        // twigs that show between the leaves and drops the ones inside them; 2 cm
        // took the visible ones too.
        uv_scale: 0.9,
        silhouette_tolerance: 0.015,
        min_radial: 4,
        min_bark_radius: 0.013,
        cull_from_level: 2,
        max_radial: 24,
        root_flare: 0.55,
        flare_height: 1.0,
        root_taper: 2.6,
        root_grooves: 0.05,
        root_sharpness: 0.8,
        root_count: 4,
        tip_length: 0.05,
        socket_flare: 0.3,
        bark_texture: "bark_birch",
        // The foot of an old birch goes dark and rough while the rest stays white.
        bark_darken_low: 0.55,
        irregularity: (
            flute_depth: 0.028,
            flute_waves: 3.0,
            flute_twist: 0.04,
            swell_depth: 0.040,
            swell_period: 4.0,
            burl_density: 0.06,
            burl_depth: 0.22,
            burl_size: 0.30,
            // The dark branch scars are painted into the bark, so the geometry only
            // has to carry the few that stand proud enough to catch the light.
            knot_density: 0.14,
            knot_depth: 0.09,
            knot_size: 0.14,
            knot_reach: 2.5,
            knot_min_stem: 1.3,
            collar_depth: 0.45,
            min_radius: 0.020,
            rings_per_meter: 12.0,
            ring_tolerance: 0.02,
        ),
    ),
    envelope: (
        // The volumes below are metres around a trunk this long; declared longer or
        // shorter, they stretch along it so the crown keeps its place on the tree.
        for_trunk_length: 20.0,
        volumes: [
            // Tall and narrow: a birch of twenty metres spreads seven or eight, where
            // the oak spreads more than its own height. The lobes lean the crown a
            // little off the axis so it is not a solid of revolution.
            Ellipsoid(center: (0.0, 13.8, 0.0), radii: (5.4, 6.4, 5.4)),
            Ellipsoid(center: (0.5, 18.2, -0.5), radii: (3.6, 3.6, 3.6)),
            Ellipsoid(center: (-1.0, 10.2, 0.8), radii: (5.0, 4.6, 5.0)),
            Ellipsoid(center: (1.3, 12.2, 1.6), radii: (4.1, 4.0, 4.1)),
        ],
        falloff: 0.30,
        kill_threshold: 0.025,
        pull_strength: 0.36,
    ),
)
