(
    name: "Pine",
    seed: 1,
    // Four levels, not five: trunk, limbs, branchlets, shoots. The shoot a pine carries
    // its needles on is what each foliage card is a photograph of, so growing a level
    // of twigs below it only buries the cards in wood. The fifth entry below is kept so
    // `Branch levels` in the viewer has something to grow if it is raised.
    max_levels: 4,
    max_split_depth: 1,
    // A mature Scots pine as a forest grows one: a tall straight bole, a band of dead
    // limbs under the living crown that the crown shaded out as it climbed, and above
    // that a crown of long sinuous limbs carrying their needles in brush-like tufts at
    // the ends, with sky and branchwork showing between them.
    trunk: (
        length: 28.0,
        length_variance: 0.06,
        // The studio reference's bole is a sixtieth of its height across; at 0.42 and
        // the usual exponent, with the limbs' wood summed in, this one was twice that.
        radius: 0.3,
        radius_ratio: 0.6,
        taper: 0.08,
        da_vinci_exponent: 2.7,
        // A whorl every other segment (see `pattern`), so twice this is the spacing of
        // the tiers. Closer than the 1.1 it was: the studio reference's tiers stack nearer, and at the wider
        // spacing the cone read as a ladder.
        segment_length: 0.9,
        curvature: 0.004,
        phototropism: 0.03,
        gravity: 0.003,
        zigzag_deg: 0.0,
        vigor_falloff: 0.3,
        split_probability: 0.01,
        split_angle_deg: 10.0,
        // A conifer never gives up its leader: the rare fork stays a side branch and
        // the spire carries on.
        split_evenness: 0.0,
        split_start_fraction: 0.8,
        children: (
            // Seven to a whorl on every second segment, so the tiers stand a little over
            // two metres apart. It was five on every segment, and the crown came out as
            // one even lollipop; a Scots pine's crown is a stack of flat pads of foliage
            // with gaps between, and the gaps come from the tier spacing while the pads
            // come from `planarity` on the levels below.
            pattern: Whorl(every: 2, count: 7),
            start_fraction: 0.12,
            end_fraction: 0.99,
            crotch_angle_deg: 100.0,
            crotch_angle_tip_deg: 50.0,
            crotch_variance_deg: 10.0,
            roll_variance_deg: 30.0,
            phyllotaxis_deg: 137.5,
            scale: 0.5,
            scale_variance: 0.5,
            dominance: 0.5,
            acrotony: -0.22,
            planarity: 0.4,
            count_variance: 2,
            // The crown has climbed past the lower half of the bole, and what it left
            // behind stands dead: whole limbs with their twigs, bleached, carrying
            // nothing. Under the envelope's base they were pruned at birth and are
            // stubs instead. The blend is kept narrow on purpose — at 0.2 living limbs
            // were scattered down through the dead band and it stopped reading as a
            // band at all. `pine_carries_its_dead_limbs_under_a_living_crown` holds it.
            shade_line: 0.58,
            shade_blend: 0.08,
            // Once dead, a limb settles about its base, a little. Without it the dead
            // band radiated as tidily as the crown; at 35 degrees the long ones hung
            // down the bole in strings, and the reference's dead limbs mostly stand
            // out level or a touch above.
            dead_sag_deg: 12.0,
            // And shed of their needles they spring back up: the reference's dead limbs
            // rise off the bole and curve up like antlers, where held level they read
            // as a ladder of pegs. Kinked, too: dry wood is crooked, not the smooth arc
            // it grew as. Sag above 12 pulled them back to level.
            dead_curl_deg: 25.0,
            dead_kink_deg: 12.0,
            // The limbs the crown has only just closed over keep their twigs and their
            // needles, gone rust-brown, for a season or two: the reference's first tree
            // hangs a dead brown clump under its lowest living whorl. Reaching the whorl
            // below the living crown, with `shed` taking its share, comes to a limb or
            // three on about half the seeds; at 0.05 it stayed inside the lowest living
            // whorl and read as mottling in it.
            wither: 0.09,
            // Weighed by its dead needles the withered limb gives a little; its twigs
            // hang (below). At 15 the limbs themselves arched down into an umbrella,
            // and the steep ones lay along the bole.
            wither_droop_deg: 5.0,
            // The dead limbs stopped growing when they died and have lost their ends
            // since, so the oldest, lowest ones keep only this much of their length,
            // rising to all of it for the ones that have only just died under the
            // crown. It is what tapers the dead band in toward the ground.
            // A forest pine keeps few of its dead: the reference carries a handful of
            // stubs, not a thicket, and the lowest are pegs.
            shade_keep: 0.1,
            // And many have dropped off whole: the reference's bole carries one dead
            // limb here and another there, where keeping them all stood a whorl of
            // pegs at every node.
            shed: 0.45,
            // The rest leave from anywhere between their whorl and the one below, so
            // the dead band is a scatter at no spacing the eye can find rather than a
            // ladder of pairs every 1.8 m. That is what let `shed` come down from 0.6:
            // more limbs, and still no rungs.
            shade_scatter: 1.0,
        ),
    ),
    branch_levels: [
        (
            // The limbs. Sinuous rather than straight: a pine limb is laid down a
            // season at a time and each season's shoot sets off at its own angle, which
            // is what the zigzag and the curvature stand for. Held near level, though:
            // the studio reference carries each whorl as one flat tier, and the longer,
            // hanging, wandering limbs this had blurred the tiers into a single mass
            // with foliage trailing below the crown.
            length: 6.0,
            length_variance: 0.4,
            radius: 0.11,
            radius_ratio: 0.45,
            taper: 0.12,
            da_vinci_exponent: 2.3,
            segment_length: 0.4,
            curvature: 0.05,
            phototropism: 0.03,
            gravity: 0.03,
            droop: 0.4,
            zigzag_deg: 4.0,
            vigor_falloff: 0.5,
            dieback: 0.02,
            snap_radius: 0.02,
            split_probability: 0.05,
            split_angle_deg: 25.0,
            split_evenness: 0.0,
            dead_stub_length: 0.9,
            split_start_fraction: 0.35,
            children: (
                // Raised when `tip_reach` began holding every branch to the one ahead of it:
                // shorter branches carry fewer twigs, so it takes more to the metre to keep the
                // crown as full.
                pattern: Continuous(density: 4.5),
                start_fraction: 0.2,
                end_fraction: 0.97,
                crotch_angle_deg: 55.0,
                crotch_angle_tip_deg: 35.0,
                crotch_variance_deg: 15.0,
                roll_variance_deg: 25.0,
                phyllotaxis_deg: 137.5,
                scale: 0.5,
                scale_variance: 0.4,
                dominance: 0.3,
                acrotony: 0.5,
                planarity: 0.9,
                count_variance: 0,
                // The twigs left on a dead limb no longer hold the flat spray they grew
                // in, and warp as the wood dries, up as often as down. Kept in it they
                // lay along the limb in a bundle, seen edge on from the side, where the
                // reference's splay out from it in forks. The twigs that die inside the
                // living crown only sag, and are hidden.
                dead_sag_deg: 40.0,
                // Then turn up and crook along their length, as the limb does, into the
                // reference's short upswept forks. At 40 they stood as a comb of candles.
                dead_curl_deg: 25.0,
                dead_kink_deg: 25.0,
                // The withered limb's twigs trail below it in a curtain, as the
                // reference's dead clump does, where the bare ones turn up.
                wither_droop_deg: 40.0,
                // The inside of a living limb is bare: its own outer growth shades
                // it, and the twigs there are dead ones.
                shade_line: 0.2,
                shade_blend: 0.15,
            ),
        ),
        (
            length: 2.2,
            length_variance: 0.2,
            radius: 0.035,
            radius_ratio: 0.45,
            taper: 0.16,
            da_vinci_exponent: 2.3,
            segment_length: 0.25,
            zigzag_deg: 8.0,
            dieback: 0.04,
            // Dead twigs this thin lose their ends: the reference's dead limbs carry short
            // forks, and at 0.008 they kept a metre of straight wire, at 0.02 a fan of
            // half-metre skewers off every limb.
            snap_radius: 0.035,
            curvature: 0.05,
            // Little lift and held flat to the limb's plane, so a limb's branchlets
            // lie as a pad rather than standing up off it in brushes.
            phototropism: 0.03,
            gravity: 0.02,
            vigor_falloff: 0.6,
            split_probability: 0.04,
            split_angle_deg: 22.0,
            split_start_fraction: 0.35,
            children: (
                pattern: Continuous(density: 7.0),
                start_fraction: 0.15,
                end_fraction: 0.95,
                crotch_angle_deg: 45.0,
                crotch_angle_tip_deg: 30.0,
                crotch_variance_deg: 15.0,
                roll_variance_deg: 25.0,
                phyllotaxis_deg: 137.5,
                scale: 0.55,
                scale_variance: 0.4,
                dominance: 0.35,
                acrotony: 0.3,
                planarity: 0.95,
                count_variance: 0,
                shade_line: 0.15,
                shade_blend: 0.2,
            ),
        ),
        (
            length: 0.6,
            length_variance: 0.2,
            radius: 0.016,
            radius_ratio: 0.42,
            taper: 0.2,
            da_vinci_exponent: 2.2,
            segment_length: 0.15,
            zigzag_deg: 10.0,
            dieback: 0.04,
            snap_radius: 0.004,
            curvature: 0.05,
            phototropism: 0.09,
            gravity: 0.015,
            vigor_falloff: 0.6,
            split_probability: 0.0,
            split_angle_deg: 18.0,
            split_start_fraction: 0.4,
            children: (
                pattern: Continuous(density: 5.0),
                start_fraction: 0.2,
                end_fraction: 0.95,
                crotch_angle_deg: 40.0,
                crotch_variance_deg: 15.0,
                roll_variance_deg: 25.0,
                phyllotaxis_deg: 137.5,
                scale: 0.55,
                scale_variance: 0.35,
                dominance: 0.35,
                acrotony: 0.3,
                planarity: 0.7,
                count_variance: 0,
            ),
        ),
        (
            length: 0.35,
            length_variance: 0.2,
            radius: 0.008,
            radius_ratio: 0.45,
            taper: 0.25,
            da_vinci_exponent: 2.2,
            segment_length: 0.1,
            zigzag_deg: 10.0,
            dieback: 0.04,
            curvature: 0.06,
            phototropism: 0.06,
            gravity: 0.015,
            vigor_falloff: 0.65,
            split_probability: 0.0,
            split_angle_deg: 16.0,
            split_start_fraction: 0.4,
            children: (
                pattern: None,
                start_fraction: 1.0,
                end_fraction: 0.0,
                crotch_angle_deg: 30.0,
                crotch_variance_deg: 10.0,
                roll_variance_deg: 25.0,
                phyllotaxis_deg: 137.5,
                scale: 0.5,
            ),
        ),
    ],
    gravity_multiplier: 1.0,
    phototropism_multiplier: 1.0,
    envelope_scale: 1.0,
    leaves: (
        enabled: true,
        min_level: 2,
        max_twig_radius: 0.03,
        // Tufts per metre of leafy twig. Few, large tufts are what keeps the pine to
        // about 12k triangles; see `card_length`. Raised with `leafy_length` cut, so the
        // same needle sits on the last stretch of each shoot: that is what makes each
        // limb's branchlets read as one flat pad rather than a fuzz along the limb.
        // Lowered from 6.0 when leaves began to be laid back from the tip of a twig,
        // which puts the first of them at the very end of every shoot: the same
        // count of cards as before, so the crown is as full as it was tuned.
        density: 5.592,
        spacing_variance: 0.8,
        // Pine carries its needles on the last few seasons of each shoot, so the
        // foliage is a brush over the end of every twig with bare wood behind it.
        leafy_length: 0.45,
        // How the tuft is built, and the one thing here that decides whether the crown
        // reads as a pine at all. A needle brush is round: the needles leave the shoot
        // on every side. One flat card of it seen face on is a feather, and a fan of
        // them round a point is a palmate leaf — both were tried, and the tree came out
        // as an acacia and then as an oak. What reads as a pine is cards on nearly the
        // same axis as the shoot (the small crotch angle), rolled about it so that from
        // any side some are seen edge on and some face on. The negative droop turns
        // them up off the twig, which is how a pine's shoot tips stand.
        //
        // Two cards to a tuft, rolled evenly into a cross, each carrying a baked bundle
        // of sixteen shoots (the `cluster` block below). This was six cards of a single
        // shoot, then four, then two cards of five-shoot bundles, then of twelve, and
        // now fewer tufts again: the leaves went 146k triangles to 97k to 49k to 12k to
        // 7.6k, the whole tree from about 172k to about 10k, and seen as a whole tree it
        // barely changed.
        //
        // One card to a tuft halves the leaves again, and was tried: every tuft is then
        // a flat panel, and the crown comes out patchy with edge-on streaks through it.
        // It still reads as the same pine from 90 m, so it is a distance LOD, not this.
        cluster_size: 2,
        cluster_spread_deg: 20.0,
        // Square, because a baked cell is. Well past the 0.6 m where a tuft starts to
        // read as one lobed leaf, and that is a trade taken on purpose: few tufts have
        // to be big to carry the same needle. It shows up close — the odd flat card
        // seen edge on, and lobed tufts at the crown's edge against the sky — and
        // barely at all from a whole-tree distance. Three-card stars at 0.65 m fixed
        // most of that for 28k triangles, and were judged not worth it. At 1.05 m and
        // twenty shoots (about 6.6k in all) the tufts read as leafy clumps even from a
        // whole-tree distance, which is where this stopped. Against Quixel's Megaplants
        // Baltic pine in a white studio (`tools/refmatch.py`) those clumps were still
        // half again the reference's grain, and 0.66 m at more to the metre matches it,
        // filling the cone below, for 8.2k triangles of needles. Since the bake became
        // several small tufts to a card (`shoot_scatter` below) a card no longer reads
        // as one lobe at any size, and 0.82 m closes the pads back up to the
        // reference's porosity for no more triangles; 0.66 left them see-through.
        card_length: 0.82,
        card_width: 0.82,
        size_variance: 0.3,
        crotch_angle_deg: 10.0,
        crotch_variance_deg: 8.0,
        phyllotaxis_deg: 137.5,
        droop_deg: -15.0,
        twist_deg: 30.0,
        // Rolled evenly, so the two cards of a tuft are always a cross. At random they
        // line up often enough that a tuft of two goes thin from one side.
        even_roll: 1.0,
        // High, because a tuft is a volume rather than a blade, and a crown of them
        // should light as one mass with a sunny side and a shaded side.
        normal_blend: 0.8,
        curvature: 0.3,
        // Fitted to the reference's colour under a white light (`tools/fitcolour.py`),
        // with the cards varied both ways, yellow to blue and green to olive, as the
        // photograph's crown is: one green throughout read as plastic. Card by card
        // the olive end came out mauve and the crown read as camouflage; less of it
        // here, and the rest varied tuft by tuft inside the bake (`colour_variance`).
        // Refitted to the new bake: 6-seed refmatch 0.929. A tuft passes
        // under a third of what the scan's map says; at the full amount the crown
        // glowed pale with the sun behind it. At an eighth it passed so little that
        // the lit needles came out as blue-grey as the shaded ones, where the
        // reference's sunlit tips are warm and its shade cool: 0.3 is what puts that
        // split back (refmatch 0.929 to 0.939, its contrast 0.87 to 0.91), and backlit
        // the crown is only a touch paler. 0.4 scored the same and is nearer the glow.
        tint: (1.315, 1.315, 1.2),
        saturation: 0.594,
        transmission: 0.3,
        hue_variance: 0.45,
        green_variance: 0.35,
        // The needles a limb that has just died still holds. Their colour is baked
        // (`cluster.withered_color`), so no tint here; fewer of them, as they are
        // dropping. Full size: smaller cards read the bake from coarser mips, where
        // the needles close up and each card came out a solid little leaf.
        withered_tint: (1.0, 1.0, 1.0),
        withered_keep: 0.7,
        interior_shade: 0.45,
        // Soft. Sharpening kept the single airy shoots resolving as strands, but a
        // bundle's interior is dense enough to close up a few mips down, and a sharp
        // cutoff there draws each card as one jagged leaf; left soft it frays into
        // needles at the edges instead.
        edge_sharpness: 0.0,
        // Off. A tuft is a volume with no front or back, but lit as one the undersides
        // of the upper tufts, which the camera looks up at, came out a pale band over
        // the top of the crown that the reference does not have.
        backface_volume: 0.0,
        // Light comes through a needle crown in a thousand gaps; the shaded side of it
        // is darker blue-green, not black.
        self_shadow: 0.55,
        // Needle sprays baked into each card as several small brushes (see `count`
        // below); one card of them carries what four single-spray cards used to. The
        // sprays come from the two straight
        // needle brushes of the source, each leaf picking one (`sources`), with their
        // bare stalks trimmed off in the atlas so they meet at a compact base rather
        // than on crossed sticks — the stalks were half the cell and held coverage to
        // 20%; trimmed, the bundle bakes at 27%. `depth_shade` is kept low because
        // the bake stacks shoots deep enough that shading the back ones darkened the
        // whole crown.
        cluster: Some((
            // Five short brushes to a card, each a shoot of five needle sprays, their
            // bases scattered up the cell (`shoot_scatter`). Sixteen long sprays from
            // one base were a solid fan, and a crown of fans read as lobed leaves where
            // the reference's pads are many hand-sized tufts with sky between them.
            count: 25,
            shoots: 5,
            leaf_length: 0.36,
            base_angle_deg: 40.0,
            tip_angle_deg: 10.0,
            tip_scale: 0.85,
            angle_variance_deg: 7.0,
            roll_deg: 137.5,
            roll_variance_deg: 30.0,
            depth: 0.4,
            blade_twist_deg: 20.0,
            depth_shade: 0.15,
            size_variance: 0.15,
            spacing_variance: 0.3,
            shoot_curve: 0.04,
            variants: 4,
            shoot_base: 0.97,
            shoot_scatter: 0.55,
            // Each tuft a little yellower or bluer than its neighbours: the fine
            // mottle of old needle against new. At 0.7 it was confetti.
            colour_variance: 0.25,
            shoot_tip: 0.92,
            source_aspect: 0.588,
            sources: 2,
            // Two arrangements of a single shoot each for the withered cards, baked
            // straight to the straw-tan of the reference's dead clump. Sixteen shoots
            // to a card is a solid fan, and browned, alone on a dead limb, that fan
            // read as an oak leaf; three still did. One is a dead shoot. The colour is
            // baked rather than tinted because in linear light the needle art is green
            // enough that no tint short of 6x red brings it past khaki, and an export
            // cannot carry a tint that size in its maps.
            withered_variants: 2,
            withered_count: 1,
            withered_color: (0.53, 0.41, 0.29),
            cell_size: 1024,
        )),
        // The bake's source: two sprays stacked down the atlas. They are the two
        // straight needle brushes off Raw Catalog's Atlas-813-A; the branched sprays on
        // the same sheet were left out because their outline is palmate and reads as a
        // leaf at any distance. The scan is an olive Scots pine and is recoloured to a
        // glaucous blue-green, twigs left brown, and each spray's bare stalk is cut back
        // to a stub. To rebuild it from the source sheet:
        //
        //   import_textures needle_pine_scan_sheet --albedo Atlas-813-A_BaseColor.jpg
        //       --alpha Atlas-813-A_Opacity.jpg --normal Atlas-813-A_NormalOpenGL.jpg
        //       --rough Atlas-813-A_Roughness.jpg --size 4096
        //   repack_atlas needle_pine_scan_sheet needle_pine_shoot --keep 6
        //       --cell 640x1088 --pick 2,3 --rot 0,90 --trim-stalk 0.06
        //   recolor needle_pine_shoot --band 48,140 --hue 88 --sat 0.6 --val 0.95
        //
        // after which the sheet can be deleted.
        atlas_cols: 1,
        atlas_rows: 1,
        atlas_front: 0,
        atlas_back: 0,
        texture: "needle_pine_shoot",
    ),
    wind: (
        flutter: 0.5,
        flexibility: (0.05, 0.15, 0.35, 0.8),
        frequency: 0.3,
    ),
    mesh: (
        uv_scale: 1.2,
        // Three centimetres off true round before a side is added. The bole still
        // reads as round from any distance it is seen whole at, for half the sides.
        silhouette_tolerance: 0.03,
        // Three sides: what is still swept below the limbs is thin enough that a
        // triangle reads as round, and it is a quarter fewer triangles than four.
        min_radial: 3,
        // Twigs under 3 cm are not swept at all: every living branchlet and shoot sits
        // inside a needle tuft, and with the foliage on the crown looks the same with or
        // without them. With the dead twigs inside the crown going too (see
        // `dead_bark_radius`), three-sided twigs and the coarser tolerances here, the
        // bark went from 26k triangles to 4.1k. The limbs are exempt however thin — a
        // dropped limb leaves its foliage floating in the gaps.
        min_bark_radius: 0.03,
        cull_from_level: 2,
        max_radial: 16,
        root_flare: 0.7,
        flare_height: 1.2,
        root_taper: 2.0,
        root_sharpness: 1.4,
        root_count: 3,
        tip_length: 0.06,
        socket_flare: 0.35,
        // The finely scaled bark of the white spruce set from the FreePBR pack, tinted
        // to the red-brown a Scots pine's bole is from a distance in the studio
        // reference, and darkened at the foot where the old bark goes grey-brown.
        bark_texture: "bark_spruce",
        bark_tint: (1.05, 0.62, 0.44),
        bark_darken_low: 0.65,
        // Dead wood bleaches toward silver-grey, but on these the bark has mostly
        // held: the reference's dead limbs are the bole's own orange-brown, a little
        // greyer. Carried most of the way to the grey they read as bleached dowels, and
        // at 0.3 still as pale planks against the bole beside them.
        dead_wood_color: (0.26, 0.255, 0.24),
        dead_wood_weathering: 0.12,
        // The living twigs are culled at `min_bark_radius` because needles hide them;
        // the dead band carries nothing, so it is meshed finer, down to 15 mm: enough
        // for the forked remnant of a twig or two on each. At 12 mm, with every dead
        // limb kept, they made a fan of grey twiglets that read from any distance as
        // wire hanging off the bole. Dead twigs inside the living crown are hidden like the living ones
        // and are culled with them.
        dead_bark_radius: 0.005,
        irregularity: (
            flute_depth: 0.06,
            flute_waves: 5.0,
            flute_twist: 0.03,
            swell_depth: 0.04,
            swell_period: 4.0,
            burl_density: 0.1,
            burl_depth: 0.3,
            burl_size: 0.35,
            collar_depth: 0.55,
            min_radius: 0.045,
            rings_per_meter: 14.0,
            // How far the surface may move when a ring along the stem is dropped, and
            // the one bark setting here with a visible cost. At three centimetres (the
            // most it can be; it is capped at `silhouette_tolerance`) the bole keeps its
            // flutes but loses the slow swelling along its length and most of the collars
            // where limbs leave it, so up close a limb meets the trunk at a seam. That
            // was taken for the budget: 0.02 keeps both for 5.7k of bark rather than
            // 4.1k.
            //
            // What this budget does not decide any more is how a limb bends. It used to:
            // a limb curving gently for metres stays within three centimetres of the
            // straight line between any three of its rings, so the thinning kept three
            // rings of a twenty-node arc and swept it as two straight spans meeting at
            // an elbow. The mesher now holds every span to a twenty-degree turn whatever
            // the budget here, which is most of the 1.3k this tree's bark grew by.
            ring_tolerance: 0.03,
        ),
    ),
    envelope: (
        // The volumes below are metres around a trunk this long; declared longer or
        // shorter, they stretch along it so the crown keeps its place on the tree.
        for_trunk_length: 28.0,
        // A tall rounded crown over a narrow band for the dead limbs. The crown is an
        // ellipsoid rather than a cone because a mature pine's crown is nearly as wide
        // near the top as at its foot; a cone narrowed the limbs so fast they averaged
        // 2.6 m and the crown came out a column.
        //
        // The band is kept well inside the crown's width, because the dead limbs are
        // the crown the tree had when it was younger and smaller. Grown as wide as the
        // living crown they reached four and five metres from the trunk and carried two
        // kilometres of dead twig between them — a thicket where a forest pine has a
        // sparse band. It widens upward, so the oldest limbs at its foot are the
        // shortest. `pine_carries_its_dead_limbs_under_a_living_crown` holds its reach
        // and how much twig it carries, both ways.
        volumes: [
            // The living crown: a cone, as the studio reference's is, widest at its
            // foot and closing to a point over the leader, a third of the tree's height
            // across. An ellipsoid here gave the round, top-heavy head of an open-grown
            // pine.
            Cone(base_y: 16.5, apex_y: 29.6, base_radius: 5.8, apex_radius: 0.2),
            Cone(base_y: 4.5, apex_y: 17.5, base_radius: 2.0, apex_radius: 3.6),
        ],
        falloff: 0.18,
        kill_threshold: 0.03,
        // Low, so a limb reaching the edge of the narrow band stops there rather than
        // being turned to run along it: at 0.6 the dead limbs bent back into hooks.
        pull_strength: 0.25,
    ),
)
