        gravity: 0.004,
        zigzag_deg: 0.0,
        vigor_falloff: 0.35,
        split_probability: 0.02,
        split_angle_deg: 10.0,
        // A conifer never gives up its leader: the rare fork stays a side branch and
        // the spire carries on. This one number is most of what separates it from the
        // oak, which trades its trunk for a crown of equals partway up.
        split_evenness: 0.0,
        split_start_fraction: 0.7,
        children: (
            pattern: Whorl(every: 1, count: 4),
            start_fraction: 0.06,
            end_fraction: 0.99,
            crotch_angle_deg: 88.0,
            crotch_angle_tip_deg: 38.0,
            crotch_variance_deg: 14.0,
            roll_variance_deg: 28.0,
            phyllotaxis_deg: 137.5,
            scale: 0.46,
            scale_variance: 0.5,
            // A whorl is a cohort of equals, held that way by the leader above it, so
            // the skewed lottery that builds a broadleaf crown is turned almost off
            // here. What varies between whorls is age, not rank: the lowest ones have
            // had the most seasons to extend, which is the negative acrotony.
            dominance: 0.15,
            acrotony: -0.35,
            planarity: 1.0,
            count_variance: 4,
        ),
    ),
