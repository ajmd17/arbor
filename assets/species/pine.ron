    gravity_multiplier: 1.0,
    phototropism_multiplier: 1.0,
    envelope_scale: 1.0,
    leaves: (
        enabled: true,
        min_level: 2,
        max_twig_radius: 0.045,
        // One card carries four fascicle sprays rather than one, on a card 1.6 times
        // the side. The needles keep the size they had; what changes is that a canopy
        // needs a third of the cards to hold the same foliage. The needle art is sparse
        // — 16% of its own cell is opaque, against 38% for the oak's leaf cluster — so
        // a pine card was mostly empty quad, and enlarging it is nearly free.
        density: 4.1,
        cluster_size: 1,
        cluster_spread_deg: 26.0,
        card_length: 0.72,
        card_width: 0.72,
        size_variance: 0.35,
        crotch_angle_deg: 38.0,
        crotch_variance_deg: 16.0,
        phyllotaxis_deg: 99.5,
        droop_deg: 8.0,
        twist_deg: 60.0,
        normal_blend: 0.65,
        curvature: 0.3,
        tint: (1.0, 1.02, 0.92),
        hue_variance: 0.07,
        interior_shade: 0.45,
        // The art is a spray of fascicles rather than a single needle, so the
        // generator is assembling shoots out of shoots here. `leaf_length` is set so a
        // spray comes out the size it was on the old smaller card: this buys cards, not
        // bigger needles. The angles are shallow and the curve pronounced, because what
        // is being built is one branchlet leaning off a twig, not a rosette.
        cluster: Some((
            count: 4,
            leaf_length: 0.45,
            base_angle_deg: 52.0,
            tip_angle_deg: 24.0,
            tip_scale: 0.9,
            angle_variance_deg: 26.0,
            roll_deg: 137.5,
            roll_variance_deg: 45.0,
            depth: 0.65,
            blade_twist_deg: 55.0,
            depth_shade: 0.35,
            size_variance: 0.28,
            spacing_variance: 0.7,
            shoot_curve: 0.40,
            variants: 4,
            shoot_base: 0.86,
            shoot_tip: 0.24,
            source_aspect: 1.0,
            cell_size: 512,
        )),
        atlas_cols: 1,
        atlas_rows: 1,
        atlas_front: 0,
        atlas_back: 0,
        texture: "needle_pine",
    ),
    wind: (
        strength: 0.35,
        gustiness: 0.4,
        flutter: 0.5,
        flexibility: (0.05, 0.15, 0.35, 0.8),
    ),
    mesh: (
        // The same forest budget as the oak. A conifer carries its branchlets buried in
        // needles, so meshing them down to six millimetres of radius was paying for wood
        // that is not visible from any angle: 1875 stems became 158 and 25k triangles
        // became 4k, with no change at all to the tree in needle.
        uv_scale: 1.2,
        silhouette_tolerance: 0.018,
        min_radial: 4,
        min_bark_radius: 0.016,
        max_radial: 32,
        root_flare: 0.9,
        flare_height: 1.4,
        root_taper: 2.0,
        root_sharpness: 1.4,
        root_count: 3,
        tip_length: 0.06,
        socket_flare: 0.35,
        bark_texture: "bark_pine",
        irregularity: (
            flute_depth: 0.115,
            flute_waves: 4.0,
            flute_twist: 0.07,
            swell_depth: 0.085,
            swell_period: 3.2,
            burl_density: 0.4,
            burl_depth: 0.46,
            burl_size: 0.42,
            collar_depth: 0.55,
            min_radius: 0.045,
            rings_per_meter: 14.0,
            ring_tolerance: 0.018,
        ),
    ),
    envelope: (
        volumes: [
            Cone(base_y: 6.5, apex_y: 20.0, base_radius: 4.2, apex_radius: 0.55),
