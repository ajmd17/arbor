(
    name: "Ivy",
    seed: 1,
    max_levels: 3,
    max_split_depth: 0,
    // Common ivy climbing a garden wall four metres wide and three high. A few thick
    // runners come up from the root and climb, meandering; they throw side shoots out
    // across the face, which throw shoots of their own, and the whole of it lies flat
    // on the wall and stops where the wall is already covered. The leaves turn their
    // faces out and shingle over one another. A few shoots stand off the wall: the
    // bushy growth an old ivy puts out once it has found the light.
    vine: Some((
        support: Wall(width: 4.0, height: 3.0, thickness: 0.3),
        start: Foot,
        runners: 6,
        heading_deg: 0.0,
        fan_deg: 28.0,
        adhesion: 0.95,
        reach: 0.1,
        twine: 0.0,
        stand_off: 0.05,
        stand_off_deg: 45.0,
        crowding: 0.2,
        crowding_cell: 0.08,
        free_length: 0.35,
        leaf_lift_deg: 22.0,
    )),
    // The runners.
    trunk: (
        length: 5.5,
        length_variance: 0.2,
        radius: 0.016,
        radius_ratio: 0.6,
        taper: 0.35,
        da_vinci_exponent: 2.2,
        segment_length: 0.06,
        curvature: 0.12,
        phototropism: 0.06,
        gravity: 0.0,
        vigor_falloff: 0.2,
        split_probability: 0.0,
        children: (
            pattern: Continuous(density: 4.0),
            start_fraction: 0.05,
            end_fraction: 0.95,
            crotch_angle_deg: 60.0,
            crotch_variance_deg: 15.0,
            scale: 0.6,
            scale_variance: 0.3,
        ),
    ),
    branch_levels: [
        (
            // Shoots across the face, climbing a little as they go.
            length: 1.6,
            length_variance: 0.3,
            radius: 0.007,
            radius_ratio: 0.6,
            taper: 0.4,
            da_vinci_exponent: 2.1,
            segment_length: 0.05,
            curvature: 0.18,
            phototropism: 0.03,
            gravity: 0.0,
            vigor_falloff: 0.3,
            split_probability: 0.0,
            children: (
                pattern: Continuous(density: 5.0),
                start_fraction: 0.1,
                end_fraction: 0.95,
                crotch_angle_deg: 60.0,
                crotch_variance_deg: 15.0,
                scale: 0.55,
                scale_variance: 0.3,
            ),
        ),
        (
            length: 0.5,
            length_variance: 0.35,
            radius: 0.003,
            radius_ratio: 0.55,
            taper: 0.4,
            da_vinci_exponent: 2.0,
            segment_length: 0.04,
            curvature: 0.2,
            phototropism: 0.01,
            gravity: 0.01,
            vigor_falloff: 0.5,
            split_probability: 0.0,
            children: (
                pattern: None,
                start_fraction: 1.0,
                end_fraction: 0.0,
            ),
        ),
    ],
    gravity_multiplier: 1.0,
    phototropism_multiplier: 1.0,
    envelope_scale: 1.0,
    leaves: (
        enabled: true,
        // Ivy is in leaf all along its stems, the oldest runners included.
        min_level: 0,
        max_twig_radius: 0.05,
        density: 26.0,
        spacing_variance: 0.6,
        leafy_length: 0.0,
        cluster_size: 1,
        card_length: 0.085,
        card_width: 0.085,
        size_variance: 0.35,
        crotch_angle_deg: 55.0,
        crotch_variance_deg: 20.0,
        phyllotaxis_deg: 180.0,
        droop_deg: 25.0,
        twist_deg: 12.0,
        normal_blend: 0.35,
        curvature: 0.3,
        tint: (1.0, 1.0, 1.0),
        hue_variance: 0.12,
        interior_shade: 0.45,
        atlas_cols: 2,
        atlas_rows: 1,
        atlas_front: 1,
        atlas_back: 0,
        texture: "leaf_ivy",
    ),
    wind: (
        flutter: 0.6,
        // Held to the wall: only the leaves and the shoots standing off it move.
        flexibility: (0.0, 0.03, 0.08, 0.15),
        frequency: 1.0,
    ),
    mesh: (
        // Old ivy stems are grey-brown and fibrous.
        uv_scale: 6.0,
        silhouette_tolerance: 0.0015,
        min_radial: 3,
        max_radial: 8,
        min_bark_radius: 0.0015,
        root_flare: 0.0,
        flare_height: 0.0,
        tip_length: 0.01,
        socket_flare: 0.2,
        bark_texture: "bark_oak",
        bark_tint: (0.6, 0.55, 0.47),
        irregularity: (
            flute_depth: 0.0,
            swell_depth: 0.0,
            burl_density: 0.0,
            knot_density: 0.0,
            collar_depth: 0.2,
            min_radius: 0.05,
            rings_per_meter: 20.0,
            ring_tolerance: 0.002,
        ),
    ),
)
