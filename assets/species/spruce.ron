(
    name: "Spruce",
    seed: 1,
    max_levels: 5,
    max_split_depth: 1,
    // A spruce is a pine's habit stretched and closed up. It holds one leader for its
    // whole life like any conifer, but it carries it half again as high on a bole that
    // barely tapers, hangs its branchlets where a pine holds them out, and wears the
    // crown right down to the ground instead of shedding its lower limbs. Almost
    // everything below is one of those four. The douglas fir preset is the opposite
    // tree in every one of them: see `douglas_fir.ron`.
    trunk: (
        length: 27.0,
        length_variance: 0.1,
        radius: 0.3,
        radius_ratio: 0.6,
        // The straightest timber tree here and the slowest to taper, holding its girth
        // well up the bole. That is what carries a crown to thirty metres without the
        // spire going spindly. Against Quixel's Megaplants Norway spruce in a white
        // studio (`tools/refmatch.py`) the bole was twice the reference's width for its
        // height, most of it the limbs' wood summed into it, hence the thinner base
        // and the higher exponent below.
        taper: 0.075,
        da_vinci_exponent: 2.8,
        segment_length: 0.6,
        curvature: 0.003,
        phototropism: 0.015,
        gravity: 0.003,
        zigzag_deg: 0.0,
        vigor_falloff: 0.22,
        split_probability: 0.015,
        split_angle_deg: 9.0,
        // Zero, and later up the bole than the pine allows. A spruce that forked low would
        // be a different tree; what the occasional fork gives is the forked top of an
        // old one, never a second trunk.
        split_evenness: 0.0,
        split_start_fraction: 0.78,
        children: (
            // A whorl every segment, of three, varying by two either way. The same
            // number of limbs as a whorl of five every other segment, but spread twice
            // as finely up the bole, and that is the difference between a crown and a
            // stack of plates: at the coarser spacing a short whorl left a gap a metre
            // deep that the tiers above and below could not cover, and the silhouette
            // pinched in at the waist. A pine whorls in tidy cohorts; a spruce does not.
            pattern: Whorl(every: 1, count: 3),
            start_fraction: 0.09,
            end_fraction: 0.995,
            // Down past horizontal at the foot and steeply up at the leader. That
            // sweep down the trunk is what draws the outline in: the lowest limbs
            // leave level while the top ones are still climbing, so the crown narrows
            // to a spire rather than stopping flat. Any further past horizontal and a
            // limb spends its length going down instead of out, and the crown loses
            // half a metre of width through its whole middle. The lowest whorls start
            // a little way up the bole: the reference stands on a short bare foot.
            crotch_angle_deg: 95.0,
            crotch_angle_tip_deg: 38.0,
            crotch_variance_deg: 13.0,
            roll_variance_deg: 32.0,
            phyllotaxis_deg: 137.5,
            scale: 0.46,
            scale_variance: 0.52,
            dominance: 0.18,
            // Negative: the lowest whorls have had thirty seasons to extend and the top
            // one has had a single season, and on a tree this tall that spread of ages
            // is the whole silhouette. It was twice this, which left the top quarter of
            // the crown at half the reference's fill.
            acrotony: -0.1,
            planarity: 1.0,
            count_variance: 2,
        ),
    ),
    branch_levels: [
        (
            // The limbs. Long enough that the ones in the middle of the crown reach
            // the envelope rather than stopping short of it; the lowest overshoot it
            // and are cut back, which is the way round the envelope is meant to be
            // used. A spruce's droop is mostly in its branchlets, and putting it in the
            // limbs as forces pinched the crown: a limb that sags spends its length
            // dropping rather than reaching. The studio reference's limbs leave the
            // trunk heading down, bottom out partway and turn their tips back up, and
            // that is drawn as a shape instead (`swoop_deg`).
            length: 8.0,
            length_variance: 0.3,
            radius: 0.085,
            radius_ratio: 0.5,
            taper: 0.13,
            da_vinci_exponent: 2.3,
            segment_length: 0.38,
            curvature: 0.045,
            phototropism: 0.017,
            gravity: 0.016,
            droop: 0.7,
            swoop_deg: 30.0,
            zigzag_deg: 1.5,
            vigor_falloff: 0.42,
            dieback: 0.06,
            snap_radius: 0.05,
            split_probability: 0.05,
            split_angle_deg: 19.0,
            split_evenness: 0.0,
            // Longer than the pine's stub because the bole it has to clear is half as
            // thick again. A stub is measured from the centreline, so anything under
            // the trunk radius stays buried in the bark instead of standing off it.
            dead_stub_length: 1.05,
            split_start_fraction: 0.35,
            children: (
                // Raised when `tip_reach` began holding every branch to the one ahead of it:
                // shorter branches carry fewer twigs, so it takes more to the metre to keep the
                // crown as full.
                pattern: Continuous(density: 3.6),
                start_fraction: 0.1,
                end_fraction: 0.9,
                crotch_angle_deg: 66.0,
                crotch_angle_tip_deg: 32.0,
                crotch_variance_deg: 14.0,
                roll_variance_deg: 10.0,
                phyllotaxis_deg: 180.0,
                scale: 0.5,
                scale_variance: 0.42,
                dominance: 0.3,
                acrotony: 0.25,
                planarity: 0.95,
                count_variance: 0,
            ),
        ),
        (
            // Where the hang starts. From here down every level gets more gravity and
            // more droop than the one above it, so a spray leaves its limb roughly level
            // and is hanging by the time it ends. Held out straight instead, the same
            // foliage reads as a spruce.
            length: 2.9,
            length_variance: 0.35,
            radius: 0.05,
            radius_ratio: 0.45,
            taper: 0.15,
            da_vinci_exponent: 2.3,
            segment_length: 0.3,
            zigzag_deg: 3.0,
            dieback: 0.07,
            snap_radius: 0.04,
            curvature: 0.045,
            phototropism: 0.006,
            gravity: 0.08,
            droop: 3.0,
            vigor_falloff: 0.55,
            split_probability: 0.05,
            split_angle_deg: 20.0,
            split_start_fraction: 0.35,
            children: (
                pattern: Continuous(density: 4.4),
                start_fraction: 0.12,
                end_fraction: 0.9,
                crotch_angle_deg: 56.0,
                crotch_angle_tip_deg: 30.0,
                crotch_variance_deg: 14.0,
                roll_variance_deg: 12.0,
                phyllotaxis_deg: 180.0,
                scale: 0.55,
                scale_variance: 0.4,
                dominance: 0.33,
                acrotony: 0.3,
                planarity: 0.92,
                count_variance: 0,
            ),
        ),
        (
            length: 1.15,
            length_variance: 0.4,
            radius: 0.024,
            radius_ratio: 0.42,
            taper: 0.18,
            da_vinci_exponent: 2.2,
            segment_length: 0.2,
            zigzag_deg: 6.0,
            dieback: 0.09,
            snap_radius: 0.03,
            curvature: 0.05,
            phototropism: 0.004,
            gravity: 0.05,
            droop: 3.8,
            vigor_falloff: 0.6,
            split_probability: 0.0,
            split_angle_deg: 17.0,
            split_start_fraction: 0.4,
            children: (
                pattern: Continuous(density: 5.5),
                start_fraction: 0.15,
                end_fraction: 0.9,
                crotch_angle_deg: 46.0,
                crotch_variance_deg: 14.0,
                roll_variance_deg: 14.0,
                phyllotaxis_deg: 180.0,
                scale: 0.55,
                scale_variance: 0.35,
                dominance: 0.35,
                acrotony: 0.3,
                planarity: 0.88,
                count_variance: 0,
            ),
        ),
        (
            length: 0.46,
            length_variance: 0.4,
            radius: 0.011,
            radius_ratio: 0.45,
            taper: 0.24,
            da_vinci_exponent: 2.2,
            segment_length: 0.11,
            zigzag_deg: 10.0,
            dieback: 0.1,
            snap_radius: 0.02,
            curvature: 0.06,
            phototropism: 0.002,
            gravity: 0.048,
            droop: 4.2,
            vigor_falloff: 0.65,
            split_probability: 0.0,
            split_angle_deg: 15.0,
            split_start_fraction: 0.4,
            children: (
                pattern: None,
                start_fraction: 1.0,
                end_fraction: 0.0,
                crotch_angle_deg: 30.0,
                crotch_variance_deg: 10.0,
                roll_variance_deg: 25.0,
                phyllotaxis_deg: 137.5,
                scale: 0.5,
            ),
        ),
    ],
    gravity_multiplier: 1.0,
    phototropism_multiplier: 1.0,
    envelope_scale: 1.0,
    leaves: (
        enabled: true,
        // Needles on every shoot thin enough to carry them, leader and limbs as well
        // as twigs, and along all of it (`leafy_length` 0): a spruce keeps its needles
        // seven years or more, so a shoot is clothed back from its tip, not tufted at
        // it. Held to the twigs, the top of the tree, whose limbs are too short to
        // have twigs yet, stood as a bare leader hung with sticks.
        min_level: 0,
        max_twig_radius: 0.05,
        // The needle art is a whole branchlet rather than a fascicle, and 29% of its own
        // cell is opaque against the pine needle's 16%. That is nearly twice the foliage
        // per card, which is what pays for a crown this dense: a spruce is not a tree you
        // see the sky through.
        //
        // Density is the whole cost of this tree. A spruce carries far more twig than
        // anything else here, so at a pine's card size it wanted 48k cards — four times
        // the oak — for a canopy no fuller. Cards cost by the count and cover by the
        // area, and the first saving was trading count for size; past about a metre
        // they start catching the light as flat slabs and the needle grain goes, and
        // the tiers the whole tree reads by smear into one cone.
        //
        // So the second saving leaves the card where it was and bakes more into it:
        // thirteen sprays to a card rather than four (see the cluster block), and a
        // bit over a third as many cards. The leaves went from 56.5k triangles to
        // 20.9k, and the tiers survive. It is a little more open than it was — about a
        // third less needle per cubic metre, most of it needle that sat behind other
        // needle — which `open_grown_douglas_fir_is_a_sparse_spire_that_still_hangs`
        // measures against, since the open fir is judged relative to this tree.
        //
        // The studio reference then wanted a finer grain than 0.84 m cards give: at
        // that size the crown read as a cone of flat flakes three times coarser than
        // the photograph's. Half-metre cards at 1.9 to the metre match its grain and
        // the sky through it, for 7.6k triangles; held near the twig's plane (`twist`)
        // they lie in the flat tiers a spruce is seen in from the ground. The scanned
        // sprays the cards are now baked from are lacier than the ones before, a sixth
        // of their cell rather than a fifth; with the shoots clothed their whole length
        // 1.2 to the metre carries the same sky through the crown as the reference.
        density: 1.2,
        spacing_variance: 0.72,
        leafy_length: 0.0,
        cluster_size: 1,
        cluster_spread_deg: 28.0,
        card_length: 0.6,
        card_width: 0.6,
        // The sprays sag in the middle and turn back up at the tip (`dip_deg`) rather
        // than standing out flat, three quads to a card: longer, fewer cards than a
        // flat spray takes, for 29k to 35k triangles of needle. That is what reads as
        // a spruce close to; a distant LOD can go back to one quad.
        arch_deg: 0.0,
        dip_deg: 35.0,
        card_segments: 3,
        size_variance: 0.35,
        crotch_angle_deg: 44.0,
        crotch_variance_deg: 18.0,
        phyllotaxis_deg: 99.5,
        // A spruce's needles come off the shoot all the way round and the spray hangs, so
        // the cards sit shallower to the twig and droop further than a pine's.
        droop_deg: 18.0,
        twist_deg: 15.0,
        normal_blend: 0.65,
        curvature: 0.3,
        // Cooler than the pine. A spruce reads blue-green where a pine reads yellow-
        // green, and the difference is visible across a whole hillside. The scans are
        // a grown crown's dark olive, so the tint moves them toward the reference's
        // colour under a white light, but only as far as a real needle's colour goes
        // (`tools/fitalbedo.py ... conifer`): green 0.11, red and blue at most 0.75
        // and 0.45 of it. Fitted to the photograph alone the needles went to blue
        // 0.64 of green, a grey-blue no shoot has, which read as frost under any real
        // sky; the studio's own sheen is what greys the photograph's crown. The cards
        // vary both ways, old needle and new, as the photograph's crown does. The crown's inside is held
        // dark (`interior_shade`) against the lift: a dark scan brightened evenly
        // flattens the crown to a grey-green felt, a third less contrast than the
        // photograph's, where the reference is bright at its tips and near black
        // against the trunk. A shoot packed with needles passes
        // a tenth of what the scan's map says; at the full amount a spruce seen
        // against the light glows pale as frost. `backface_volume` is off: it lit the
        // undersides of the upper sprays, which the camera looks up at, a pale band
        // over the top half of the tree.
        tint: (2.218, 2.587, 5.255),
        saturation: 0.801,
        transmission: 0.10,
        hue_variance: 0.2,
        green_variance: 0.15,
        interior_shade: 0.7,
        edge_sharpness: 0.6,
        backface_volume: 0.0,
        self_shadow: 0.35,
        cluster: Some((
            // Thirteen sprays to a card, curved hard. `leaf_length` holds a spray to
            // the size it would have had on its own, so this buys cards rather than
            // bigger needles; `shoot_curve` is what makes them sweep the same way instead
            // of standing up like a hand of cards. Past about twenty the bake stops
            // getting fuller, and the card starts to read as felt.
            //
            // That was thirteen of the dense branchlet this was first built from, then
            // twenty-eight of a young, airy scanned spray. The grown sprays it uses now
            // are whole side shoots, branchlets on branchlets, so twelve of them at
            // 63 cm fill the cell to a third, and fewer layers over each other keep
            // the needle grain the reference has instead of baking it to felt: the
            // crown's grain went from 0.83 of the photograph's to 0.93. The open fir's
            // sparseness is asserted against this tree's needle, so the cell cannot be
            // let go much thinner than it is.
            count: 12,
            leaf_length: 0.75,
            base_angle_deg: 56.0,
            tip_angle_deg: 26.0,
            tip_scale: 0.88,
            angle_variance_deg: 24.0,
            roll_deg: 137.5,
            roll_variance_deg: 42.0,
            depth: 0.6,
            blade_twist_deg: 50.0,
            depth_shade: 0.38,
            size_variance: 0.26,
            spacing_variance: 0.65,
            shoot_curve: 0.45,
            variants: 4,
            shoot_base: 0.88,
            shoot_tip: 0.22,
            source_aspect: 0.667,
            sources: 6,
            cell_size: 1024,
        )),
        // The bake's source: six Norway spruce sprays stacked down the sheet, cut from
        // Raw Catalog's Atlas-666-A to Atlas-669-A, the darker green of a grown crown
        // rather than new growth, so they are used as scanned. The sheets carry no map
        // of the light through them, and a spruce needle passes little enough that the
        // albedo stands in. Each is a spray that already stands on its cut end, but
        // for the one turned over. To rebuild it:
        //
        //   import_textures spruce_dark_sheet --size 2048 --rawcatalog
        //       1156_spruce-branches,1157_spruce-branches,
        //       1158_spruce-branches,1159_spruce-branches
        //   repack_atlas spruce_dark_sheet needle_spruce_dark --keep 14
        //       --pick 1,2,4,5,6,11 --rot 0,180,0,0,0,0 --cell 512x768
        //
        // after which the sheet can be deleted.
        atlas_cols: 1,
        atlas_rows: 1,
        atlas_front: 0,
        atlas_back: 0,
        texture: "needle_spruce_dark",
    ),
    wind: (
        flutter: 0.4,
        flexibility: (0.04, 0.12, 0.3, 0.75),
        frequency: 0.28,
    ),
    mesh: (
        // Spruce bark is thinner and scalier than a pine's, in small flaking plates
        // rather than deep plates, so the flutes run shallow. What it does carry is
        // knots: a spruce keeps its lower limbs, and the ones it does lose leave scars
        // all the way down a bole that never had a clear length.
        uv_scale: 1.0,
        silhouette_tolerance: 0.03,
        min_radial: 3,
        min_bark_radius: 0.03,
        cull_from_level: 2,
        max_radial: 16,
        root_flare: 1.0,
        flare_height: 1.8,
        root_taper: 2.2,
        root_sharpness: 1.3,
        root_count: 4,
        tip_length: 0.06,
        socket_flare: 0.35,
        // The scaly grey spruce scan, nearly as it comes: the studio reference's bole is
        // a cool mid-grey (L 32). The pine's art lifted toward it stayed half as light
        // and brown, and a dark trunk that size pulled the whole tree's colour down so
        // far that the needles were fitted pale to make it up.
        bark_texture: "bark_spruce",
        bark_tint: (0.95, 0.94, 0.86),
        bark_darken_low: 0.1,
        irregularity: (
            flute_depth: 0.09,
            flute_waves: 7.0,
            flute_twist: 0.05,
            swell_depth: 0.07,
            swell_period: 3.6,
            // A spruce carries far fewer burls than a pine and far more branch scars.
            burl_density: 0.15,
            burl_depth: 0.34,
            burl_size: 0.38,
            knot_density: 0.45,
            knot_depth: 0.13,
            knot_size: 0.26,
            knot_reach: 3.0,
            knot_min_stem: 1.3,
            collar_depth: 0.5,
            min_radius: 0.045,
            rings_per_meter: 15.0,
            ring_tolerance: 0.03,
        ),
    ),
    envelope: (
        // The volumes below are metres around a trunk this long; declared longer or
        // shorter, they stretch along it so the crown keeps its place on the tree.
        for_trunk_length: 27.0,
        volumes: [
            // Two cones, because one cannot do both jobs. The foliage fills whatever
            // envelope it is given, so this is the silhouette, and the reference has a
            // body that widens dead straight from the tip down with a separate spire over the
            // top of it. A single cone through the body overshoots the spire by half
            // again; a single cone through the spire loses a third of the width at
            // mid-height. Carried nearly to the ground, so the lowest whorls live and
            // the crown ends in a skirt rather than on a bare pole.
            //
            // The spire closes six tenths of a metre over the leader, not under it. The
            // top whorls need that much crown around them to grow limbs long enough to
            // carry a twig; closed at the leader's own height, the spruce stood half a
            // metre to a metre and a half of bare leader over its needles.
            Cone(base_y: 2.8, apex_y: 21.5, base_radius: 4.9, apex_radius: 3.1),
            Cone(base_y: 19.5, apex_y: 27.8, base_radius: 2.9, apex_radius: 0.35),
        ],
        // Tighter than the default quarter. Drive fades from `1 - falloff` of the way
        // out, so at 0.25 a limb is already being starved from three quarters of the
        // radius and the crown settles most of a metre inside the shape it was given.
        falloff: 0.16,
        kill_threshold: 0.03,
        pull_strength: 0.6,
    ),
)
