// A split slab of bedded stone, low and wide: flat top and crisp edges, stepped where
// it has cleaved along its layers, moss creeping over its top.
// Any number in shape, surface or moss may be a (lo, hi) range: each seed lands in it.
(
    name: "slab",
    seed: 1,
    shape: (
        width: (2.2, 3.2),
        height: (0.6, 0.9),
        depth: (1.6, 2.4),
        facets: (11.0, 15.0),
        facet_depth: (0.3, 0.4),
        sharpness: (28.0, 40.0),
        bulge: 0.05,
        bulge_scale: 1.1,
        ridges: 0.025,
        fracture: 0.035,
        flat_bottom: 0.35,
        bury: 0.15,
    ),
    surface: (
        grain: 0.008,
        cracks: 0.016,
        crack_spread: 0.6,
        strata: 0.007,
        cavity: 1.0,
    ),
    moss: (
        amount: (0.0, 0.25),
        upward: 1.3,
        patchiness: 0.8,
        softness: 0.2,
        crevices: 0.35,
        dry: 0.35,
    ),
    colour: (
        stone: (0.45, 0.44, 0.42),
        warm: (0.50, 0.45, 0.38),
        streaks: 0.3,
    ),
    lod: [
        (resolution: 40, screen_size: 0.0),
        (resolution: 20, screen_size: 0.15),
        (resolution: 10, screen_size: 0.05),
    ],
    texture: (
        resolution: 512,
    ),
)
