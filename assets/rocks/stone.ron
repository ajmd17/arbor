// A loose stone, 30 to 60 cm: for scattering round the foot of bigger rocks and along
// paths. Fewer triangles and a smaller sheet of maps, since there will be many of them.
// Any number in shape, surface or moss may be a (lo, hi) range: each seed lands in it.
(
    name: "stone",
    seed: 1,
    shape: (
        width: (0.35, 0.6),
        height: (0.2, 0.35),
        depth: (0.3, 0.5),
        facets: (8.0, 11.0),
        facet_depth: (0.2, 0.32),
        sharpness: (10.0, 18.0),
        wear: 0.5,
        bulge: 0.07,
        bulge_scale: 1.4,
        undulation: 0.02,
        chips: 0.02,
        chip_size: 0.4,
        flaking: 0.5,
        flake_step: 0.012,
        flake_size: 0.4,
        bedded: 0.0,
        fracture: 0.0,
        flat_top: 0.0,
        flat_bottom: 0.25,
        bury: 0.15,
    ),
    surface: (
        grain: 0.001,
        pitting: 0.15,
        cracks: (0.0, 1.0),
        crack_width: 0.003,
        strata: 0.0,
        cavity: 1.0,
    ),
    moss: (
        amount: (-0.3, 0.1),
        upward: 1.1,
        patchiness: 1.0,
        softness: 0.2,
        crevices: 0.3,
        dry: 0.3,
    ),
    colour: (
        stone: (0.41, 0.40, 0.38),
        warm: (0.46, 0.42, 0.37),
        lichen_size: 0.04,
    ),
    lod: [
        (triangles: 600, screen_size: 0.0),
        (triangles: 200, screen_size: 0.1),
        (triangles: 60, screen_size: 0.04),
    ],
    texture: (
        size: 1024,
    ),
)
