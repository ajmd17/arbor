// Meadow grass, 0.3 to 0.8 m: mostly upright thin blades over a short dense understory,
// some pale feathery seed heads, a little dry. Tuned against photoreal UE meadows.
// Any number may be a (lo, hi) range: each seed lands somewhere in it.
(
    name: "meadow_grass",
    seed: 1,
    footprint: (
        size: 1.5,
        tufts: 64,
        jitter: 1.0,
        overhang: 0.15,
    ),
    tuft: (
        cards: 7,
        radius: 0.12,
        height: (0.55, 0.7),
        height_variance: 0.35,
        card_height_variance: 0.25,
        lean_deg: 6.0,
        lean_variance_deg: 5.0,
        curl_deg: 6.0,
        twist_deg: 20.0,
        understory: 0.45,
        understory_height: 0.35,
    ),
    card: (
        width: 1.0,
        width_top: 1.1,
    ),
    colour: (
        dry_fraction: 0.12,
        mix: 0.1,
    ),
    normals: (
        ground_normal_blend: 0.8,
        root_blend: 0.12,
    ),
    wind: (
        flexibility: (0.0, 0.6, 0.0, 0.0),
        flutter: 0.1,
        frequency: 1.1,
    ),
    lod: [
        (cards: 1.0, segments: 4, width: 1.0, screen_size: 0.0),
        (cards: 0.5, segments: 2, width: 1.35, screen_size: 0.08),
        (cards: 0.2, segments: 1, width: 1.9, screen_size: 0.035),
    ],
    atlas: (
        cell_height: 1024,
        cell_aspect: 0.5,
        cells: [
            // Upright thin blades, the bulk of the sward.
            (
                weight: 1.0,
                count: 110,
                length: (0.3, 0.97),
                width: 0.0075,
                lean_deg: 7.0,
                curve_deg: 18.0,
                droop_power: 2.5,
                wiggle_deg: 5.0,
                kink: 0.05,
                fan: 0.2,
                root_spread: 0.85,
                root: (0.15, 0.23, 0.10),
                tip: (0.25, 0.37, 0.16),
                color_variance: 0.22,
                dead: 0.1,
                mottle: 0.12,
                tip_burn: 0.1,
                root_shade: 0.8,
                roughness: 0.55,
                seed: 11,
            ),
            // Broader, longer blades, some flopping over at the top.
            (
                weight: 1.0,
                count: 85,
                length: (0.35, 0.97),
                width: 0.0095,
                lean_deg: 10.0,
                curve_deg: 35.0,
                droop_power: 2.8,
                wiggle_deg: 6.0,
                kink: 0.1,
                fan: 0.25,
                root_spread: 0.85,
                root: (0.14, 0.23, 0.11),
                tip: (0.23, 0.36, 0.18),
                color_variance: 0.22,
                dead: 0.12,
                mottle: 0.12,
                tip_burn: 0.12,
                root_shade: 0.8,
                roughness: 0.55,
                seed: 23,
            ),
            // Flowering: thin stems with pale feathery panicles standing out of the leaves.
            (
                weight: 0.25,
                count: 90,
                heads: 3,
                length: (0.3, 0.9),
                width: 0.007,
                lean_deg: 7.0,
                curve_deg: 15.0,
                droop_power: 2.5,
                fan: 0.2,
                root_spread: 0.85,
                root: (0.15, 0.23, 0.10),
                tip: (0.26, 0.38, 0.17),
                color_variance: 0.22,
                dead: 0.1,
                root_shade: 0.8,
                head_length: 0.2,
                head_width: 0.3,
                head_spread: 0.8,
                head: (0.52, 0.50, 0.38),
                roughness: 0.55,
                seed: 37,
